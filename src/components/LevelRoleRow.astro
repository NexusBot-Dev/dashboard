---
// Eine Zeile der Level-Rollen-Liste. Wird für die gespeicherten Rollen gerendert und — ohne role — als
// <template>, aus dem das Skript neue Zeilen klont (src/scripts/pages/levels.ts).
import Badge from './Badge.astro';

interface Props {
  role?: { level: number; role_id: string; role_name: string; role_color: string };
  botOnline: boolean;
}

const { role, botOnline } = Astro.props;
const t = Astro.locals.t;
---

<div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-level-role-row={role?.level ?? ''} data-role-id={role?.role_id ?? ''}>
  <div class="w-24 flex-shrink-0"><Badge variant="primary"><span data-field="badge">{role && t('levels.level_badge', { level: role.level })}</span></Badge></div>
  <div class="flex items-center gap-2 flex-1 min-w-0">
    <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" data-field="color" style={role ? `background-color: ${role.role_color}` : undefined}></span>
    <span class="text-sm font-medium text-slate-900 dark:text-white truncate" data-field="name">{role?.role_name}</span>
  </div>
  <div class="flex items-center gap-3 flex-shrink-0">
    <button type="button" data-edit-level-role disabled={!botOnline} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline disabled:opacity-50">{t('common.edit')}</button>
    <button type="button" data-remove-level-role disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">{t('common.remove')}</button>
  </div>
</div>
