---
// Ein/Aus-Schalter (<button role="switch">). Umschalten im Browser: setSwitch() aus src/scripts/switch.ts —
// die Farb- und Knopf-Klassen hier müssen zu denen dort passen.
// Weitere Attribute (id, data-*) werden an den Button durchgereicht.
interface Props {
  checked: boolean;
  disabled?: boolean;
  id?: string;
  [dataAttr: `data-${string}`]: string;
}

const { checked, disabled = false, ...attrs } = Astro.props;
---

<button type="button" role="switch" aria-checked={checked} disabled={disabled} {...attrs}
  class:list={["relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 disabled:opacity-50", checked ? "bg-primary-500" : "bg-slate-300 dark:bg-slate-700"]}>
  <span class:list={["inline-block h-4 w-4 transform rounded-full bg-white transition-transform", checked ? "translate-x-6" : "translate-x-1"]}></span>
</button>
