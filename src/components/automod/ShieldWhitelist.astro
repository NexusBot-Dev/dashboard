---
// Whitelist fürs Anti-Nuke-Shield (Bot: systems/shield_whitelist.py) im Shield-Tab der AutoMod-Seite.
// Skript: setupShieldWhitelist in src/scripts/pages/automod.ts.
// Rechte wie im Bot: Bots ein-/austragen nur Owner und Administratoren, Rollen nur der Owner.
import Switch from '../Switch.astro';

export interface ShieldBot {
  id: string;
  name: string | null;   // null: eingetragen, aber gerade nicht auf dem Server/im Cache
  avatar: string | null;
  mod_permissions: boolean;
  whitelisted: boolean;
}

export interface ShieldWhitelistData {
  bots: ShieldBot[];
  roles: string[];
  can_manage_bots: boolean;
  is_owner: boolean;
  limits: { bots: number; roles: number };
}

interface Props {
  data: ShieldWhitelistData;
  roles: { id: string; name: string }[];
  botOnline: boolean;
}

const { data, roles, botOnline } = Astro.props;
const t = Astro.locals.t;

const whitelistedBots = data.bots.filter((b) => b.whitelisted).length;
const canBots = botOnline && data.can_manage_bots;
const canRoles = botOnline && data.is_owner;
// Eingetragene Rollen, die das Dashboard nicht kennt: mit ID anzeigen, damit sie beim Speichern nicht verloren gehen
const roleOptions = [...roles, ...data.roles.filter((id) => !roles.some((r) => r.id === id)).map((id) => ({ id, name: id }))];

const listClass = 'max-h-72 overflow-y-auto rounded-lg border border-slate-800 bg-slate-950/40 p-2 space-y-1';
const checkClass = 'flex items-center gap-2 px-2 py-1 rounded text-sm text-slate-300 hover:bg-slate-800/60 cursor-pointer';
const inputClass = 'w-full px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50';
const hintClass = 'text-xs text-amber-400';
---

<section class="rounded-xl glass-panel p-6" id="shield-bots" data-max={data.limits.bots}>
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="min-w-0">
      <h2 class="text-base font-bold text-white mb-1">{t('automod.shield_bots_title')}</h2>
      <p class="text-sm text-slate-400">{t('automod.shield_bots_desc')}</p>
    </div>
    <span class="shrink-0 text-xs text-slate-400" data-shield-bot-count>{whitelistedBots} / {data.limits.bots}</span>
  </div>
  {!data.can_manage_bots && <p class={`${hintClass} mb-3`}>{t('automod.shield_bots_admin_only')}</p>}

  {data.bots.length === 0 ? (
    <p class="text-sm text-slate-400">{t('automod.shield_bots_empty')}</p>
  ) : (
    <>
      <input type="search" id="shield-bot-search" class={`${inputClass} mb-3`} placeholder={t('automod.shield_bots_search')}
        aria-label={t('automod.shield_bots_search')} autocomplete="off" />
      <ul class={listClass}>
        {data.bots.map((bot) => (
          <li class="flex items-center gap-3 px-2 py-1.5 rounded hover:bg-slate-800/60" data-shield-bot-row
            data-search={`${(bot.name ?? '').toLowerCase()} ${bot.id}`}>
            {bot.avatar
              ? <img src={bot.avatar} alt="" width="32" height="32" loading="lazy" class="h-8 w-8 shrink-0 rounded-full" />
              : <span class="h-8 w-8 shrink-0 rounded-full bg-slate-800" aria-hidden="true"></span>}
            <div class="min-w-0 flex-1">
              <p class="text-sm text-white truncate">
                {bot.name ?? t('automod.shield_bot_unknown')}
                {bot.mod_permissions && (
                  <span class="ml-1.5 inline-block px-1.5 py-0.5 rounded bg-amber-500/15 text-[11px] font-medium text-amber-400 align-middle">{t('automod.shield_bot_mod_badge')}</span>
                )}
              </p>
              <p class="text-xs text-slate-500 font-mono truncate">{bot.id}</p>
            </div>
            <Switch checked={bot.whitelisted} data-shield-bot={bot.id} disabled={!canBots}
              aria-label={t('automod.shield_bot_switch', { name: bot.name ?? bot.id })} />
          </li>
        ))}
      </ul>
      <p class="hidden mt-2 text-sm text-slate-400" data-shield-no-results>{t('automod.shield_bots_no_results')}</p>
    </>
  )}
</section>

<section class="rounded-xl glass-panel p-6" id="shield-roles" data-max={data.limits.roles}>
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="min-w-0">
      <h2 class="text-base font-bold text-white mb-1">{t('automod.shield_roles_title')}</h2>
      <p class="text-sm text-slate-400">{t('automod.shield_roles_desc')}</p>
    </div>
    <span class="shrink-0 text-xs text-slate-400" data-shield-role-count>{data.roles.length} / {data.limits.roles}</span>
  </div>
  {!data.is_owner && <p class={`${hintClass} mb-3`}>{t('automod.shield_roles_owner_only')}</p>}

  {roleOptions.length === 0 ? (
    <p class="text-sm text-slate-400">{t('automod.shield_roles_empty')}</p>
  ) : (
    <>
      <div class={listClass} data-shield-roles>
        {roleOptions.map((r) => (
          <label class={checkClass}>
            <input type="checkbox" value={r.id} checked={data.roles.includes(r.id)} disabled={!canRoles} class="accent-primary-500" />@{r.name}
          </label>
        ))}
      </div>
      {data.is_owner && (
        <button type="button" id="shield-roles-save" disabled
          class="mt-3 px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
          {t('common.save')}
        </button>
      )}
    </>
  )}
</section>
