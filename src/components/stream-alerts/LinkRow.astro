---
// Eine Verknüpfung zweier Kanäle. Wird für die gespeicherten Verknüpfungen gerendert und — ohne link — als
// <template>, aus dem das Skript neue Zeilen klont. Jede Seite enthält alle Plattform-Icons, sichtbar ist das passende.
import PlatformIcon from '../icons/PlatformIcon.astro';
import { PLATFORM_META } from '../../lib/streamPlatforms';

type Side = { subscription_id: number; platform: string; streamer_name: string };

interface Props {
  link?: { id: number; a: Side; b: Side };
}

const { link } = Astro.props;
const t = Astro.locals.t;
const sides = [['a', link?.a], ['b', link?.b]] as const;
---

<div class="flex items-center gap-3 p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-link-row={link?.id ?? ''} data-subscription-ids={link ? `${link.a.subscription_id},${link.b.subscription_id}` : ''}>
  {sides.map(([key, side], i) => (
    <>
      {i === 1 && <span class="text-slate-400">↔</span>}
      <span class="inline-flex items-center gap-1.5 text-sm text-slate-900 dark:text-white" data-side={key}>
        {Object.entries(PLATFORM_META).map(([platform, meta]) => (
          <span data-platform-icon={platform} class:list={['inline-flex', { hidden: side?.platform !== platform }]}>
            <PlatformIcon platform={platform} class={`w-4 h-4 ${meta.colorClass}`} />
          </span>
        ))}
        <span data-field="name">{side?.streamer_name}</span>
      </span>
    </>
  ))}
  <button type="button" data-remove-link class="ml-auto text-xs font-medium text-red-600 dark:text-red-400 hover:underline">{t('stream_alerts.disconnect_btn')}</button>
</div>
