---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { getSession } from '../lib/session';

const t = Astro.locals.t;

const session = await getSession(Astro.cookies);
if (session) {
  return Astro.redirect('/server');
}
---

<DashboardLayout title={t('landing.page_title')}>
  <div class="min-h-[75vh] flex flex-col items-center justify-center relative">

    <!-- Subtiler Ambient Glow im Hintergrund -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-[#5865F2]/10 blur-[120px] pointer-events-none -z-10 rounded-full"></div>

    <div class="max-w-md w-full text-center space-y-6 px-4">

      <!-- Headline & Intro -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          {t('landing.headline_prefix')} <span class="text-primary-400">Nexus</span> {t('landing.headline_suffix')}
        </h1>
        <p class="text-sm text-slate-400">
          {t('landing.intro')}
        </p>
      </div>

      <!-- Login Card -->
      <div class="p-6 rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur-md shadow-2xl space-y-4">
        <a
          href="/auth/login"
          class="w-full flex items-center justify-center gap-3 px-6 py-3.5 text-base font-semibold text-white bg-[#5865F2] hover:bg-[#4752C4] rounded-xl shadow-lg shadow-[#5865F2]/20 transition-all hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 127.14 96.36">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.91,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,45.91,96.12,53,91.08,65.69,84.69,65.69Z"/>
          </svg>
          <span>{t('landing.login_with_discord')}</span>
        </a>

        <p class="text-xs text-slate-500">
          {t('landing.privacy_note')}
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>
