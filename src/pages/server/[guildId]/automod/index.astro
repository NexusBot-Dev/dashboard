---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import ModuleToggle from '../../../../components/ModuleToggle.astro';
import { getModuleStates } from '../../../../lib/modules';
import Switch from '../../../../components/Switch.astro';
import RuleCard from '../../../../components/automod/RuleCard.astro';
import ShieldWhitelist, { type ShieldWhitelistData } from '../../../../components/automod/ShieldWhitelist.astro';
import { DEFAULT_LIMITS, LEGACY_KINDS, PRESETS, RULE_KINDS, type RuleData, type RuleKind, type RuleLimits, type RuleTexts } from '../../../../lib/automodRules';
import Tabs from '../../../../components/Tabs.astro';
import MarkdownToolbar from '../../../../components/MarkdownToolbar.astro';
import pool from '../../../../lib/db';
import { callGuildAction } from '../../../../lib/botApi';
import { intlLocale } from '../../../../i18n';
import { renderPreview } from '../../../../lib/discordMarkdown';

const { guildId } = Astro.params;
const moduleEnabled = (await getModuleStates(guildId!).catch(() => null))?.automod ?? false;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let channels: { id: string; name: string }[] = [];
let roles: { id: string; name: string }[] = [];
let status: {
  spam_enabled: boolean; mentions_enabled: boolean; keywords_enabled: boolean;
  keywords: string[]; shield_enabled: boolean; honeypot_channel_id: string | null;
  // Ausschalten nur durch den Owner (ältere Bot-Versionen liefern es nicht → jeder)
  shield_can_disable?: boolean;
  honeypot_timeout_days: number; honeypot_catches?: number;
  // Seit /honeypot: Warn-Texte und Bestrafung (ältere Bot-Versionen liefern sie nicht)
  honeypot_title?: string; honeypot_text?: string;
  honeypot_punish_members?: string; honeypot_punish_bots?: string; honeypot_day_options?: number[];
  // AutoMod 2.0 (ältere Bot-Versionen liefern es nicht): Testphase, Regeln mit Einstellungen, fremde Regeln
  v2?: boolean;
  rules?: Partial<Record<RuleKind, RuleData | null>>;
  foreign_rules?: Partial<Record<RuleKind, string>>;
  rule_limits?: RuleLimits;
} | null = null;
// Shield-Whitelist: eigene Aktion (lädt im Bot beim ersten Mal die Mitgliederliste). null: älterer Bot oder Fehler
let shieldWhitelist: ShieldWhitelistData | null = null;
let botOnline = true;
let premiumActive = false;

async function getPremiumInfo(id: string) {
  const [rows] = await pool.query(
    `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

try {
  const [premium, info, channelsResult, rolesResult, statusResult, whitelistResult] = await Promise.all([
    getPremiumInfo(guildId!),
    callGuildAction(Astro, 'guild', 'info', guildId!),
    callGuildAction(Astro, 'guild', 'channels', guildId!),
    callGuildAction(Astro, 'guild', 'roles', guildId!),
    callGuildAction(Astro, 'automod', 'status', guildId!),
    callGuildAction(Astro, 'automod', 'shield-whitelist', guildId!).catch(() => null),
  ]);

  premiumActive = Boolean(premium);
  guildName = info.name;
  guildIconUrl = info.icon_url;
  channels = channelsResult.channels;
  roles = rolesResult.roles;
  status = statusResult;
  shieldWhitelist = whitelistResult;
} catch {
  botOnline = false;
}

const honeypotChannelName = status?.honeypot_channel_id
  ? channels.find((c) => c.id === status!.honeypot_channel_id)?.name ?? null
  : null;

// Honeypot — Standardwerte entsprechen dem bisherigen Verhalten (Mitglieder: Timeout, Bots: Kick)
const PUNISHMENTS = ['timeout', 'kick', 'ban'] as const;
const honeypotDays = status?.honeypot_timeout_days ?? 7;
const dayOptions = [...new Set([...(status?.honeypot_day_options ?? [1, 3, 7, 14, 28]), honeypotDays])].sort((a, b) => a - b);
const daysLabel = (days: number) => (days === 1 ? t('automod.days_option_one') : t('automod.days_option', { days }));
const punishLabel = (action: string) => t(`automod.punish_${action}`);
const punishMembers = status?.honeypot_punish_members ?? 'timeout';
const punishBots = status?.honeypot_punish_bots ?? 'kick';
const honeypotTitle = status?.honeypot_title ?? '';
const honeypotText = status?.honeypot_text ?? '';
const labelClass = 'block text-xs font-medium text-slate-300 mb-1.5';
const inputClass = 'w-full px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50';
const saveBtnClass = 'px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed';

// AutoMod 2.0: alle Regeln mit Einstellungen — sonst (Testphase, älterer Bot) nur die drei bisherigen
const v2 = Boolean(status?.v2 && status.rules && status.rule_limits);
const ruleKinds: readonly RuleKind[] = v2 ? RULE_KINDS : LEGACY_KINDS;
const legacyEnabled: Partial<Record<RuleKind, boolean>> = {
  spam: status?.spam_enabled, mentions: status?.mentions_enabled, keywords: status?.keywords_enabled,
};
const ruleOf = (kind: RuleKind): RuleData | null => (v2 ? status?.rules?.[kind] ?? null : null);
const mentionLimit = ruleOf('mentions')?.mention_limit ?? 5;
const ruleLimits = status?.rule_limits ?? DEFAULT_LIMITS;
// Die drei bisherigen Regeln behalten ihre Texte
const TITLE_KEYS: Record<RuleKind, string> = {
  spam: 'automod.anti_spam_title', mentions: 'automod.mention_spam_title', keywords: 'automod.keyword_filter_title',
  presets: 'automod.rule_presets_title', links: 'automod.rule_links_title', names: 'automod.rule_names_title',
};
const DESC_KEYS: Partial<Record<RuleKind, string>> = {
  spam: 'automod.anti_spam_desc', keywords: 'automod.keyword_filter_desc',
  presets: 'automod.rule_presets_desc', links: 'automod.rule_links_desc', names: 'automod.rule_names_desc',
};
const ruleTitle = (kind: RuleKind) => t(TITLE_KEYS[kind]);
const ruleDescription = (kind: RuleKind) =>
  kind === 'mentions'
    ? `${t('automod.mention_spam_desc_prefix')} ${mentionLimit} ${t(v2 ? 'automod.mention_spam_desc_suffix_v2' : 'automod.mention_spam_desc_suffix')}`
    : t(DESC_KEYS[kind]!);
const ruleTexts: RuleTexts = {
  minutes: t('automod.duration_minutes'), hours: t('automod.duration_hours'), days: t('automod.duration_days'), week: t('automod.duration_weeks'),
  timeoutOff: t('automod.timeout_off'),
  summaryWords: t('automod.summary_words'), summaryAllowed: t('automod.summary_allowed'), summaryRoles: t('automod.summary_roles'),
  summaryChannels: t('automod.summary_channels'), summaryTimeout: t('automod.summary_timeout'), summaryLimit: t('automod.summary_limit'),
  summaryRaid: t('automod.summary_raid'), summaryInvites: t('automod.summary_invites'), summaryDomains: t('automod.summary_domains'),
  summaryPartners: t('automod.summary_partners'), summaryNotice: t('automod.summary_notice'),
  one: {
    words: t('automod.summary_words_one'), allowed: t('automod.summary_allowed_one'), roles: t('automod.summary_roles_one'),
    channels: t('automod.summary_channels_one'), domains: t('automod.summary_domains_one'), partners: t('automod.summary_partners_one'),
  },
  presets: Object.fromEntries(PRESETS.map((p) => [p, t(`automod.preset_${p}`)])),
};
const SHIELD_WINDOW_SECONDS = 5;
const SHIELD_SCORE_LIMIT = 3.0;

const i18n = {
  noKeywords: t('automod.no_keywords'),
  alertHoneypotRequired: t('automod.alert_honeypot_required'),
  confirmDeleteHoneypot: t('automod.confirm_delete_honeypot'),
  alertWarnTextRequired: t('automod.alert_warn_text_required'),
  alertTextReposted: t('automod.alert_text_reposted'),
  alertTextSavedOnly: t('automod.alert_text_saved_only'),
  save: t('common.save'),
  saving: t('common.saving'),
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('automod.unexpected_response'),
  confirmAdoptTemplate: t('automod.confirm_adopt'),   // enthält "{name}"
  allowListUsageTemplate: t('automod.allow_list_usage'),   // enthält "{count}" und "{max}"
};

const tabs = [
  { key: 'automod', label: t('automod.tab_automod') },
  { key: 'honeypot', label: t('automod.tab_honeypot') },
  { key: 'shield', label: t('automod.tab_shield') },
];

// Liest src/scripts/pages/automod.ts aus data-config
const shieldLocked = Boolean(status?.shield_enabled && status.shield_can_disable === false);
const pageConfig = { guildId, i18n, v2, ruleTexts, shieldCanDisable: status?.shield_can_disable ?? true };
---

<DashboardLayout title={t('automod.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-white mb-1">{t('automod.title')}</h1>

  <ModuleToggle guildId={guildId!} moduleKey="automod" name={t('automod.title')} enabled={moduleEnabled} disabled={!botOnline}>{t('automod.subtitle')}</ModuleToggle>

  {!botOnline && (
    <div class="rounded-lg border border-amber-900/50 bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  {status && (
    <div id="automod-page" data-config={JSON.stringify(pageConfig)}>
    <Tabs tabs={tabs} label={t('automod.title')} />

    <!-- Tab: AutoMod — eine aufklappbare Karte pro Regel (src/components/automod/RuleCard.astro) -->
    <div role="tabpanel" id="tab-panel-automod" aria-labelledby="tab-automod" data-tab-panel="automod" class="space-y-6">
      {ruleKinds.map((kind) => (
        <RuleCard
          kind={kind} title={ruleTitle(kind)} description={ruleDescription(kind)} rule={ruleOf(kind)}
          enabled={(v2 ? ruleOf(kind)?.enabled : legacyEnabled[kind]) ?? false} v2={v2}
          foreignName={v2 && !ruleOf(kind) ? status.foreign_rules?.[kind] : undefined}
          limits={ruleLimits} texts={ruleTexts} roles={roles} channels={channels} botOnline={botOnline}
        >
          {kind === 'keywords' && (
            <div class="mt-4">
              <div class="flex flex-wrap gap-2 mb-3" id="keywords-display">
                {status.keywords.map((kw) => (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-800 text-xs font-mono text-slate-300">{kw}</span>
                ))}
                {status.keywords.length === 0 && <span class="text-xs text-slate-400">{t('automod.no_keywords')}</span>}
              </div>

              <button id="edit-keywords-btn" type="button" disabled={!botOnline} class="text-xs font-medium text-primary-400 hover:underline disabled:opacity-50">{t('automod.edit_keywords_btn')}</button>

              <div id="keywords-form" class="hidden mt-3 pt-3 border-t border-slate-800">
                <label class="block text-xs font-medium text-slate-300 mb-1.5">{t('automod.blocked_words_label')}</label>
                <textarea id="keywords-textarea" rows="5" maxlength="1000" class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-white text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none">{status.keywords.join('\n')}</textarea>
                <div class="flex gap-2 mt-3">
                  <button id="confirm-keywords-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-400 transition-colors">{t('common.save')}</button>
                  <button id="cancel-keywords-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white transition-colors">{t('common.cancel')}</button>
                </div>
              </div>
            </div>
          )}
        </RuleCard>
      ))}
    </div>

    <!-- Tab: Shield (Anti-Nuke) — eigener Tab, damit er später eigene Einstellungen bekommen kann -->
    <div role="tabpanel" id="tab-panel-shield" aria-labelledby="tab-shield" data-tab-panel="shield" class="hidden space-y-6">
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-white mb-1">{t('automod.anti_nuke_title')}</h2>
            <p class="text-sm text-slate-400 mb-2">{t('automod.anti_nuke_desc')}</p>
            <p class="text-xs text-slate-400">{t('automod.shield_threshold', { score: SHIELD_SCORE_LIMIT, seconds: SHIELD_WINDOW_SECONDS })}</p>
          </div>
          <Switch checked={status.shield_enabled} id="shield-toggle" disabled={!botOnline || shieldLocked} />
        </div>
        <p id="shield-owner-hint" class:list={['mt-3 text-xs text-amber-400', { hidden: !shieldLocked }]}>{t('automod.shield_owner_only_hint')}</p>
      </section>

      {shieldWhitelist && <ShieldWhitelist data={shieldWhitelist} roles={roles} botOnline={botOnline} />}
    </div>

    <!-- Tab: Honeypot -->
    <div role="tabpanel" id="tab-panel-honeypot" aria-labelledby="tab-honeypot" data-tab-panel="honeypot" class="hidden space-y-6">
      <!-- Status: Channel und Fänge — oder Erstellen -->
      <section class="rounded-xl glass-panel p-6">
        <h2 class="text-base font-bold text-white mb-1">{t('automod.honeypot_title')}</h2>
        <p class="text-sm text-slate-400 mb-4">
          {t('automod.honeypot_desc')}
        </p>

        <div id="honeypot-active" class={status.honeypot_channel_id ? '' : 'hidden'}>
          <div class="flex items-center justify-between p-3 rounded-lg border border-slate-800">
            <p class="text-sm font-medium text-white" id="honeypot-channel-label">
              #{honeypotChannelName ?? status.honeypot_channel_id}
            </p>
            <button id="delete-honeypot-btn" type="button" disabled={!botOnline} class="text-xs font-medium text-red-400 hover:underline disabled:opacity-50">{t('common.delete')}</button>
          </div>
          <p class="mt-2 text-xs text-slate-400">
            <span id="honeypot-catches">{t('automod.honeypot_catches', { count: (status.honeypot_catches ?? 0).toLocaleString(intlLocale(lang)) })}</span>
            {' '}· {t('automod.delete_honeypot_note')}
          </p>
        </div>

        <div id="honeypot-inactive" class={status.honeypot_channel_id ? 'hidden' : ''}>
          <button id="create-honeypot-btn" type="button" disabled={!botOnline} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-400 transition-colors disabled:opacity-50">+ {t('automod.create_honeypot_btn')}</button>

          <div id="honeypot-form" class="hidden mt-4 pt-4 border-t border-slate-800">
            <div class="mb-3">
              <label class="block text-xs font-medium text-slate-300 mb-1.5">{t('automod.channel_name_label')}</label>
              <input type="text" id="honeypot-name-input" maxlength="90" placeholder={t('automod.channel_name_placeholder')} class="w-full max-w-sm px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div class="mb-3">
              <label for="honeypot-new-title-input" class={labelClass}>{t('automod.honeypot_title_label')}</label>
              <input type="text" id="honeypot-new-title-input" maxlength="256" placeholder={t('automod.honeypot_title_placeholder')} class={`${inputClass} max-w-sm`} />
            </div>
            <div class="mb-4">
              <label for="honeypot-warntext-input" class="block text-xs font-medium text-slate-300 mb-1.5">{t('automod.warn_text_label')}</label>
              <MarkdownToolbar target="honeypot-warntext-input" />
              <textarea id="honeypot-warntext-input" rows="3" maxlength="1000" placeholder={t('automod.warn_text_placeholder')} class="w-full px-3 py-2 rounded-lg border border-slate-700 bg-slate-900 text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"></textarea>
              <div class="mt-3 rounded-lg bg-slate-800/50 p-3">
                <p class="text-xs text-slate-400 mb-1">{t('tickets.live_preview_label')}</p>
                <p id="honeypot-warntext-preview" class="text-sm text-slate-300 italic">—</p>
              </div>
            </div>
            <div class="flex gap-2">
              <button id="confirm-honeypot-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-400 transition-colors">{t('common.create')}</button>
              <button id="cancel-honeypot-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white transition-colors">{t('common.cancel')}</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Warn-Nachricht im Channel: Speichern passt die Nachricht direkt an -->
      <section id="honeypot-message-section" data-honeypot-detail class={status.honeypot_channel_id ? 'rounded-xl glass-panel p-6' : 'hidden rounded-xl glass-panel p-6'}>
        <h2 class="text-base font-bold text-white mb-1">{t('automod.honeypot_message_title')}</h2>
        <p class="text-sm text-slate-400 mb-4">{t('automod.honeypot_message_desc')}</p>
        <div class="mb-3">
          <label for="honeypot-title-input" class={labelClass}>{t('automod.honeypot_title_label')}</label>
          <input type="text" id="honeypot-title-input" maxlength="256" value={honeypotTitle} data-initial={honeypotTitle} placeholder={t('automod.honeypot_title_placeholder')} disabled={!botOnline} class={`${inputClass} max-w-sm`} />
        </div>
        <div class="mb-3">
          <label for="honeypot-text-input" class={labelClass}>{t('automod.warn_text_label')}</label>
          <MarkdownToolbar target="honeypot-text-input" />
          <textarea id="honeypot-text-input" rows="3" maxlength="1000" data-initial={honeypotText} disabled={!botOnline} class={`${inputClass} resize-y`}>{honeypotText}</textarea>
          <div class="mt-3 rounded-lg bg-slate-800/50 p-3">
            <p class="text-xs text-slate-400 mb-1">{t('tickets.live_preview_label')}</p>
            <p id="honeypot-text-preview" class="text-sm text-slate-300 italic" set:html={honeypotText ? renderPreview(honeypotText) : '—'} />
          </div>
        </div>
        <button id="save-honeypot-text-btn" type="button" disabled class={saveBtnClass}>{t('common.save')}</button>
      </section>

      <!-- Bestrafung: getrennt für Mitglieder und Bots, Dauer gilt für Timeouts -->
      <section id="honeypot-punish-section" data-honeypot-detail class={status.honeypot_channel_id ? 'rounded-xl glass-panel p-6' : 'hidden rounded-xl glass-panel p-6'}>
        <h2 class="text-base font-bold text-white mb-1">{t('automod.honeypot_punish_title')}</h2>
        <p class="text-sm text-slate-400 mb-4">{t('automod.honeypot_punish_desc')}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-2">
          <div>
            <label for="honeypot-punish-members" class={labelClass}>{t('automod.punish_members_label')}</label>
            <select id="honeypot-punish-members" data-initial={punishMembers} disabled={!botOnline} class={inputClass}>
              {PUNISHMENTS.map((p) => <option value={p} selected={p === punishMembers}>{punishLabel(p)}</option>)}
            </select>
          </div>
          <div>
            <label for="honeypot-punish-bots" class={labelClass}>{t('automod.punish_bots_label')}</label>
            <select id="honeypot-punish-bots" data-initial={punishBots} disabled={!botOnline} class={inputClass}>
              {PUNISHMENTS.map((p) => <option value={p} selected={p === punishBots}>{punishLabel(p)}</option>)}
            </select>
          </div>
          <div>
            <label for="honeypot-days" class={labelClass}>{t('automod.timeout_days_label')}</label>
            <select id="honeypot-days" data-initial={String(honeypotDays)} disabled={!botOnline} class={inputClass}>
              {dayOptions.map((d) => <option value={String(d)} selected={d === honeypotDays}>{daysLabel(d)}</option>)}
            </select>
          </div>
        </div>
        <p class="text-xs text-slate-400 mb-3">{t('automod.punish_hint')}</p>
        <button id="save-honeypot-punish-btn" type="button" disabled class={saveBtnClass}>{t('common.save')}</button>
      </section>
    </div>
    </div>
  )}
</DashboardLayout>

<script>
  import '../../../../scripts/pages/automod';
</script>
