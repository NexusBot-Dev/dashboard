---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../components/Badge.astro';
import MarkdownToolbar from '../../../../components/MarkdownToolbar.astro';
import pool from '../../../../lib/db';
import { callGuildAction } from '../../../../lib/botApi';
import { intlLocale } from '../../../../i18n';

const { guildId } = Astro.params;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

type Giveaway = {
  id: number;
  prize: string;
  status: 'running' | 'ended' | 'cancelled';
  winners_count: number;
  participant_count: number;
  end_time: string;
  channel_id: string;
  channel_name: string | null;
  message_url: string;
};

async function getGuildSettings(id: string) {
  const [rows] = await pool.query(
    `SELECT timezone FROM guild_settings WHERE guild_id = ?`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

async function getPremiumInfo(id: string) {
  const [rows] = await pool.query(
    `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

const settingsPromise = getGuildSettings(guildId!);
const premiumPromise = getPremiumInfo(guildId!);

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let active: Giveaway[] = [];
let history: Giveaway[] = [];
let channels: { id: string; name: string }[] = [];
let limits = { max_prize: 200, max_description: 2000, max_winners: 20 };
let botOnline = true;

async function callBot(module: string, action: string) {
  try {
    return await callGuildAction(Astro, module, action, guildId!);
  } catch (err) {
    console.error(`Giveaways-Seite: ${module}/${action} fehlgeschlagen:`, err);
    throw err;
  }
}

const botInfoPromise = (async () => {
  try {
    const [info, list, channelsResult] = await Promise.all([
      callBot('guild', 'info'),
      callBot('giveaways', 'list'),
      callBot('guild', 'channels'),
    ]);
    return { ok: true as const, info, list, channels: channelsResult.channels };
  } catch {
    return { ok: false as const };
  }
})();

const [settings, premium, botResult] = await Promise.all([settingsPromise, premiumPromise, botInfoPromise]);

if (!settings) {
  return Astro.redirect('/server');
}

const premiumActive = Boolean(premium);
const timezone: string = settings.timezone || 'Europe/Berlin';
const minDate = new Date().toLocaleDateString('sv-SE', { timeZone: timezone }); // YYYY-MM-DD

if (botResult.ok) {
  guildName = botResult.info.name;
  guildIconUrl = botResult.info.icon_url;
  active = botResult.list.active;
  history = botResult.list.history;
  limits = botResult.list.limits;
  channels = botResult.channels;
} else {
  botOnline = false;
}

// Anzeige in der Server-Zeitzone, passend zur Eingabe der Endzeit (wie auf der Embeds-Seite)
function formatDate(iso: string) {
  return new Date(iso).toLocaleString(intlLocale(lang), {
    day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit',
    timeZone: timezone,
  });
}

const i18n = {
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('giveaways.unexpected_response'),
  confirmCancel: t('giveaways.confirm_cancel'),
};

// Liest src/scripts/pages/giveaways.ts aus data-config
const pageConfig = { guildId, i18n };

const inputClass =
  'w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500';
const labelClass = 'block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5';
---

<DashboardLayout title={t('giveaways.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('giveaways.title')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
    {t('giveaways.subtitle')}
  </p>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('giveaways.data_unavailable')}</p>
    </div>
  )}

  <div id="giveaways-page" data-config={JSON.stringify(pageConfig)}>
    <!-- Neues Giveaway -->
    <section class="rounded-xl glass-panel p-6 mb-6">
      <h2 class="text-base font-bold text-slate-900 dark:text-white mb-5">{t('giveaways.create_title')}</h2>

      <form data-giveaway-form class="grid gap-4 md:grid-cols-2">
        <div class="md:col-span-2">
          <label class={labelClass} for="gw-prize">{t('giveaways.prize_label')}</label>
          <input id="gw-prize" name="prize" type="text" required maxlength={limits.max_prize} placeholder={t('giveaways.prize_placeholder')} class={inputClass} />
        </div>

        <div class="md:col-span-2">
          <label class={labelClass} for="gw-description">{t('giveaways.description_label')}</label>
          <MarkdownToolbar target="gw-description" />
          <textarea id="gw-description" name="description" rows="4" maxlength={limits.max_description} placeholder={t('giveaways.description_placeholder')} class={inputClass}></textarea>
          <p class="text-xs text-slate-400 mt-2 mb-1">{t('boost.preview_label')}</p>
          <p class="text-sm text-slate-600 dark:text-slate-400 italic" id="gw-description-preview">—</p>
        </div>

        <div>
          <label class={labelClass} for="gw-channel">{t('giveaways.channel_label')}</label>
          <select id="gw-channel" name="channel_id" required disabled={channels.length === 0} class={inputClass}>
            <option value="" disabled selected>{t('giveaways.channel_placeholder')}</option>
            {channels.map((ch) => (
              <option value={ch.id}>#{ch.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class={labelClass} for="gw-winners">{t('giveaways.winners_label')}</label>
          <input id="gw-winners" name="winners_count" type="number" required min="1" max={limits.max_winners} value="1" class={inputClass} />
        </div>

        <div class="md:col-span-2">
          <div class="flex items-end gap-3 flex-wrap">
            <div>
              <label class={labelClass} for="gw-date">{t('embeds.date_label')}</label>
              <input id="gw-date" name="end_date" type="date" required min={minDate} class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label class={labelClass} for="gw-time">{t('embeds.time_label')}</label>
              <input id="gw-time" name="end_clock" type="time" required class="px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">{t('giveaways.end_time_hint', { timezone })}</p>
        </div>

        <div class="md:col-span-2 flex items-center gap-4">
          <button type="submit" disabled={!botOnline} class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            {t('giveaways.create_btn')}
          </button>
          <p class="text-sm text-red-600 dark:text-red-400 hidden" data-form-error></p>
        </div>
      </form>
    </section>

    <!-- Laufende Giveaways -->
    <section class="rounded-xl glass-panel p-6 mb-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('giveaways.active_title')}</h2>
        <span class="text-sm text-slate-500 dark:text-slate-400">{active.length}</span>
      </div>

      {active.length === 0 ? (
        <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('giveaways.no_active')}</p>
      ) : (
        <div class="space-y-3">
          {active.map((g) => (
            <div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-giveaway>
              <div class="min-w-0 flex-1">
                <p class="font-medium text-slate-900 dark:text-white truncate">🎉 {g.prize}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {g.channel_name ? `#${g.channel_name}` : '–'} · {t('giveaways.ends')} {formatDate(g.end_time)}
                </p>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {t('giveaways.participants')}: {g.participant_count} · {t('giveaways.winners')}: {g.winners_count}
                </p>
              </div>
              <div class="flex-shrink-0 text-right">
                <a href={g.message_url} target="_blank" rel="noopener noreferrer" class="block text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline">{t('giveaways.open_in_discord')}</a>
                <button type="button" data-cancel-giveaway={g.id} class="block mt-1 text-xs font-medium text-red-600 dark:text-red-400 hover:underline ml-auto">{t('giveaways.cancel_btn')}</button>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Verlauf -->
    <section class="rounded-xl glass-panel p-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('giveaways.history_title')}</h2>
        <span class="text-sm text-slate-500 dark:text-slate-400">{history.length}</span>
      </div>

      {history.length === 0 ? (
        <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('giveaways.no_history')}</p>
      ) : (
        <div class="space-y-3 max-h-[420px] overflow-y-auto pr-1" data-list="history">
          {history.map((g) => (
            <div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800">
              <div class="min-w-0 flex-1">
                <p class="font-medium text-slate-900 dark:text-white truncate">{g.prize}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {formatDate(g.end_time)} · {t('giveaways.participants')}: {g.participant_count} · {t('giveaways.winners')}: {g.winners_count}
                </p>
              </div>
              <div class="flex-shrink-0 text-right">
                <Badge variant={g.status === 'ended' ? 'success' : 'neutral'}>
                  {g.status === 'ended' ? t('giveaways.status_ended') : t('giveaways.status_cancelled')}
                </Badge>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</DashboardLayout>

<script>
  import '../../../../scripts/pages/giveaways';
</script>
