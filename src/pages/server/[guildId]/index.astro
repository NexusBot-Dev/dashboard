---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import Badge from '../../../components/Badge.astro';
import pool from '../../../lib/db';
import { callGuildAction } from '../../../lib/botApi';

const { guildId } = Astro.params;
const t = Astro.locals.t;
const lang = Astro.locals.lang;
const numberLocale = lang === 'en' ? 'en-US' : 'de-DE';

const MODULE_KEYS = ['moderation', 'levels', 'welcome', 'reaction_roles', 'boosts', 'embeds', 'automod', 'stream_alerts', 'tickets'] as const;

const MODULE_LABELS: Record<string, string> = {
  moderation: t('moderation.title'),
  levels: t('levels.title'),
  welcome: t('nav.module_welcome'),
  reaction_roles: t('reaction_roles.title'),
  boosts: t('boost.title'),
  embeds: t('embeds.title'),
  automod: t('automod.title'),
  stream_alerts: t('stream_alerts.title'),
  tickets: t('tickets.title'),
};

async function getGuildData(id: string) {
  const [[settingsRows], [premiumRows]] = await Promise.all([
    pool.query(
      `SELECT guild_id, locale, timezone, modules, setup_complete
       FROM guild_settings WHERE guild_id = ?`,
      [id]
    ),
    pool.query(
      `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
      [id]
    ),
  ]);

  const settings = (settingsRows as any[])[0];
  const premium = (premiumRows as any[])[0];

  let moduleStates: Record<string, boolean> = {};
  try {
    moduleStates = typeof settings?.modules === 'string'
      ? JSON.parse(settings.modules)
      : (settings?.modules ?? {});
  } catch {
    moduleStates = {};
  }

  return {
    settings,
    premiumActive: Boolean(premium),
    moduleStates,
  };
}

// DB und Bot parallel — der Bot liefert Guild-Infos UND Kennzahlen in einem Aufruf
const [{ settings, premiumActive, moduleStates }, overview] = await Promise.all([
  getGuildData(guildId!),
  callGuildAction(Astro, 'guild', 'overview', guildId!).catch(() => null),
]);

if (!settings) {
  return Astro.redirect('/server');
}

const isEnabled = (key: string) => key === 'moderation' || Boolean(moduleStates[key]);

const guildName: string = overview?.name ?? `Server ${guildId}`;
const guildIconUrl: string | null = overview?.icon_url ?? null;
const online: boolean = overview?.online ?? false;
const hierarchyOk: boolean = overview?.hierarchy_ok ?? true;
const uptimeSince: Date | null = overview?.uptime_since ? new Date(overview.uptime_since) : null;
const stats = overview?.stats ?? null;

function formatUptime(since: Date) {
  const diffMs = Date.now() - since.getTime();
  const hours = Math.floor(diffMs / (1000 * 60 * 60));
  const days = Math.floor(hours / 24);
  return days > 0 ? `${days}d ${hours % 24}h` : `${hours}h`;
}

const fmt = (n: number | null | undefined) => (typeof n === 'number' ? n.toLocaleString(numberLocale) : '–');
const moduleHref = (key: string) => `/server/${guildId}/modules/${key.replace('_', '-')}/`;

// Live-Streamer: bis zu 2 Namen anzeigen, Rest als "+N"
const liveNames: string[] = stats?.live_streamers ?? [];
const liveSub = liveNames.length === 0
  ? t('overview.nobody_live')
  : liveNames.slice(0, 2).join(', ') + (liveNames.length > 2 ? ` ${t('overview.live_more', { count: liveNames.length - 2 })}` : '');

// Kacheln — Module-abhängige Kacheln nur, wenn das Modul aktiv ist
const tiles = [
  { key: 'members', label: t('overview.stats_members'), value: fmt(overview?.member_count), href: moduleHref('welcome'), show: true },
  { key: 'boosts', label: t('overview.stats_boosts'), value: fmt(overview?.boost_count), sub: t('boost.level_badge', { tier: overview?.boost_tier ?? 0 }), href: moduleHref('boosts'), show: isEnabled('boosts') },
  { key: 'tickets', label: t('overview.stats_open_tickets'), value: fmt(stats?.open_tickets), href: moduleHref('tickets'), show: isEnabled('tickets') },
  { key: 'live', label: t('overview.stats_live'), value: stats ? fmt(liveNames.length) : '–', sub: stats ? liveSub : undefined, href: moduleHref('stream_alerts'), show: isEnabled('stream_alerts') },
  { key: 'timeouts', label: t('overview.stats_timeouts'), value: fmt(stats?.active_timeouts), href: moduleHref('moderation'), show: true },
].filter((tile) => tile.show);
---

<DashboardLayout title={t('nav.overview')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  {!hierarchyOk && (
    <div class="rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 p-4 mb-8 flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <div>
        <p class="text-sm font-semibold text-amber-800 dark:text-amber-300">{t('overview.hierarchy_warning_title')}</p>
        <p class="text-sm text-amber-700 dark:text-amber-400 mt-0.5">{t('overview.hierarchy_warning_desc')}</p>
      </div>
    </div>
  )}

  {!settings.setup_complete && (
    <div class="rounded-xl border border-primary-200 dark:border-primary-900/50 bg-primary-50/50 dark:bg-primary-950/10 p-4 mb-8">
      <p class="text-sm font-semibold text-primary-800 dark:text-primary-300">{t('overview.setup_incomplete_title')}</p>
      <p class="text-sm text-primary-700 dark:text-primary-400 mt-0.5">{t('overview.setup_incomplete_prefix')} <code>/setup</code> {t('overview.setup_incomplete_suffix')}</p>
    </div>
  )}

  <!-- Hero-Status -->
  <div class="rounded-2xl glass-panel p-6 md:p-8 mb-6">
    <div class="flex items-center gap-2 mb-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class:list={["animate-ping absolute inline-flex h-full w-full rounded-full opacity-75", online ? "bg-primary-500" : "bg-slate-400"]}></span>
        <span class:list={["relative inline-flex rounded-full h-2.5 w-2.5", online ? "bg-primary-500" : "bg-slate-400"]}></span>
      </span>
      <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        {online ? t('overview.bot_online') : t('overview.bot_offline_status')}
      </span>
      {premiumActive && <Badge variant="primary">Premium</Badge>}
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white">{guildName}</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      {t('overview.locale_timezone_line', { locale: settings.locale.toUpperCase(), tz: settings.timezone })}
      {uptimeSince && t('overview.running_since', { uptime: formatUptime(uptimeSince) })}
    </p>
  </div>

  <!-- Kennzahlen -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
    {tiles.map((tile) => (
      <a href={tile.href} class="group rounded-xl glass-panel p-4 hover-glow transition-colors">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{tile.label}</p>
        <p class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">{tile.value}</p>
        {tile.sub && <p class="mt-0.5 text-xs text-slate-400 truncate" title={tile.sub}>{tile.sub}</p>}
      </a>
    ))}
  </div>

  <!-- Module kompakt -->
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold text-slate-900 dark:text-white">{t('nav.modules')}</h2>
    <a href={`/server/${guildId}/modules/`} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
      {t('overview.manage_modules')}
    </a>
  </div>
  <div class="flex flex-wrap gap-2">
    {MODULE_KEYS.map((key) => (
      <a
        href={moduleHref(key)}
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg glass-panel text-sm text-slate-700 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
      >
        <span
          class:list={["w-2 h-2 rounded-full flex-shrink-0", isEnabled(key) ? "bg-emerald-500" : "bg-slate-300 dark:bg-slate-600"]}
          title={isEnabled(key) ? t('settings.active_badge') : t('settings.inactive_badge')}
        ></span>
        {MODULE_LABELS[key]}
      </a>
    ))}
  </div>

  <!-- "Letzte Aktivität" folgt mit dem Audit-Log -->
</DashboardLayout>
