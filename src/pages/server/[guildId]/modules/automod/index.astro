---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import Switch from '../../../../../components/Switch.astro';
import pool from '../../../../../lib/db';
import { callGuildAction } from '../../../../../lib/botApi';

const { guildId } = Astro.params;
const t = Astro.locals.t;

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let channels: { id: string; name: string }[] = [];
let status: {
  spam_enabled: boolean; mentions_enabled: boolean; keywords_enabled: boolean;
  keywords: string[]; shield_enabled: boolean; honeypot_channel_id: string | null;
  honeypot_timeout_days: number;
} | null = null;
let botOnline = true;
let premiumActive = false;

async function getPremiumInfo(id: string) {
  const [rows] = await pool.query(
    `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

try {
  const [premium, info, channelsResult, statusResult] = await Promise.all([
    getPremiumInfo(guildId!),
    callGuildAction(Astro, 'guild', 'info', guildId!),
    callGuildAction(Astro, 'guild', 'channels', guildId!),
    callGuildAction(Astro, 'automod', 'status', guildId!),
  ]);

  premiumActive = Boolean(premium);
  guildName = info.name;
  guildIconUrl = info.icon_url;
  channels = channelsResult.channels;
  status = statusResult;
} catch {
  botOnline = false;
}

const honeypotChannelName = status?.honeypot_channel_id
  ? channels.find((c) => c.id === status!.honeypot_channel_id)?.name ?? null
  : null;

const MENTION_LIMIT = 5;
const SHIELD_WINDOW_SECONDS = 5;
const SHIELD_SCORE_LIMIT = 3.0;

const i18n = {
  noKeywords: t('automod.no_keywords'),
  alertHoneypotRequired: t('automod.alert_honeypot_required'),
  confirmDeleteHoneypot: t('automod.confirm_delete_honeypot'),
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('automod.unexpected_response'),
};

// Liest src/scripts/pages/automod.ts aus data-config
const pageConfig = { guildId, i18n };
---

<DashboardLayout title={t('automod.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('automod.title')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {t('automod.subtitle')}
  </p>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  {status && (
    <div id="automod-page" data-config={JSON.stringify(pageConfig)} class="space-y-6">
      <!-- Anti-Spam -->
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('automod.anti_spam_title')}</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">{t('automod.anti_spam_desc')}</p>
          </div>
          <Switch checked={status.spam_enabled} data-automod-toggle="spam" disabled={!botOnline} />
        </div>
      </section>

      <!-- Mention-Spam -->
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('automod.mention_spam_title')}</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">{t('automod.mention_spam_desc_prefix')} <strong>{MENTION_LIMIT}</strong> {t('automod.mention_spam_desc_suffix')}</p>
          </div>
          <Switch checked={status.mentions_enabled} data-automod-toggle="mentions" disabled={!botOnline} />
        </div>
      </section>

      <!-- Keyword-Filter -->
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('automod.keyword_filter_title')}</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">{t('automod.keyword_filter_desc')}</p>
          </div>
          <Switch checked={status.keywords_enabled} data-automod-toggle="keywords" disabled={!botOnline} />
        </div>

        <div class="flex flex-wrap gap-2 mb-3" id="keywords-display">
          {status.keywords.map((kw) => (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-xs font-mono text-slate-700 dark:text-slate-300">{kw}</span>
          ))}
          {status.keywords.length === 0 && <span class="text-xs text-slate-400">{t('automod.no_keywords')}</span>}
        </div>

        <button id="edit-keywords-btn" type="button" disabled={!botOnline} class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline disabled:opacity-50">{t('automod.edit_keywords_btn')}</button>

        <div id="keywords-form" class="hidden mt-3 pt-3 border-t border-slate-200 dark:border-slate-800">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('automod.blocked_words_label')}</label>
          <textarea id="keywords-textarea" rows="5" maxlength="1000" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none">{status.keywords.join('\n')}</textarea>
          <div class="flex gap-2 mt-3">
            <button id="confirm-keywords-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.save')}</button>
            <button id="cancel-keywords-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
          </div>
        </div>
      </section>

      <!-- Anti-Nuke Shield -->
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('automod.anti_nuke_title')}</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-2">{t('automod.anti_nuke_desc')}</p>
            <p class="text-xs text-slate-400">{t('automod.shield_threshold', { score: SHIELD_SCORE_LIMIT, seconds: SHIELD_WINDOW_SECONDS })}</p>
          </div>
          <Switch checked={status.shield_enabled} id="shield-toggle" disabled={!botOnline} />
        </div>
      </section>

      <!-- Honeypot -->
      <section class="rounded-xl glass-panel p-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('automod.honeypot_title')}</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">
          {t('automod.honeypot_desc', { days: status.honeypot_timeout_days })}
        </p>

        <div id="honeypot-active" class={status.honeypot_channel_id ? '' : 'hidden'}>
          <div class="flex items-center justify-between p-3 rounded-lg border border-slate-200 dark:border-slate-800">
            <p class="text-sm font-medium text-slate-900 dark:text-white" id="honeypot-channel-label">
              #{honeypotChannelName ?? status.honeypot_channel_id}
            </p>
            <button id="delete-honeypot-btn" type="button" disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">{t('common.delete')}</button>
          </div>
          <p class="mt-2 text-xs text-slate-400">{t('automod.delete_honeypot_note')}</p>
        </div>

        <div id="honeypot-inactive" class={status.honeypot_channel_id ? 'hidden' : ''}>
          <button id="create-honeypot-btn" type="button" disabled={!botOnline} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-50">+ {t('automod.create_honeypot_btn')}</button>

          <div id="honeypot-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
            <div class="mb-3">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('automod.channel_name_label')}</label>
              <input type="text" id="honeypot-name-input" maxlength="90" placeholder={t('automod.channel_name_placeholder')} class="w-full max-w-sm px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
            </div>
            <div class="mb-4">
              <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('automod.warn_text_label')}</label>
              <textarea id="honeypot-warntext-input" rows="2" maxlength="1000" placeholder="⚠️ Raid bot trap: Anyone posting here will be automatically timed out." class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"></textarea>
            </div>
            <div class="flex gap-2">
              <button id="confirm-honeypot-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.create')}</button>
              <button id="cancel-honeypot-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
            </div>
          </div>
        </div>
      </section>
    </div>
  )}
</DashboardLayout>

<script>
  import '../../../../../scripts/pages/automod';
</script>
