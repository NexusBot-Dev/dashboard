---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../../components/Badge.astro';
import { callGuildAction } from '../../../../../lib/botApi';

const { guildId } = Astro.params;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let pointsMin = 5;
let pointsMax = 15;
let cooldownSeconds = 60;
let botOnline = true;

try {
  const [info, rolesResult, levelRolesResult, leaderboardResult, pointsResult] = await Promise.all([
    callGuildAction(Astro, 'guild', 'info', guildId!),
    callGuildAction(Astro, 'guild', 'roles', guildId!),
    callGuildAction(Astro, 'leveling', 'get-xp-settings', guildId!),
  ]);

  guildName = info.name;
  guildIconUrl = info.icon_url;
  pointsMin = pointsResult.points_min;
  pointsMax = pointsResult.points_max;
  cooldownSeconds = pointsResult.cooldown_seconds;
} catch {
  botOnline = false;
}

const i18n = {

}

---

<DashboardLayout title={t('giveaway.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} guildId={guildId}>

</DashboardLayout>