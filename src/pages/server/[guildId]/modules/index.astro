// Die Modul-Übersicht gibt es nicht mehr: Jedes Modul wird auf seiner eigenen Seite ein- und ausgeschaltet,
// welche Module aktiv sind, zeigt die Server-Übersicht. Die Route bleibt für alte Links und Lesezeichen.
const { guildId } = Astro.params;
return Astro.redirect(`/server/${guildId}/`, 301);
