---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../components/Badge.astro';
import pool from '../../../../lib/db';
import { callGuildAction } from '../../../../lib/botApi';

const { guildId } = Astro.params;
const t = Astro.locals.t;

const MODULE_KEYS = ['moderation', 'levels', 'welcome', 'reaction_roles', 'boosts', 'embeds', 'automod', 'stream_alerts', 'tickets'] as const;

const MODULE_LABELS: Record<string, string> = {
  moderation: t('moderation.title'), levels: t('levels.title'), welcome: t('nav.module_welcome'),
  reaction_roles: t('reaction_roles.title'), boosts: t('boost.title'), embeds: t('embeds.title'),
  automod: t('automod.title'), stream_alerts: t('stream_alerts.title'), tickets: t('tickets.title'),
};
const MODULE_DESCRIPTIONS: Record<string, string> = {
  moderation: t('modules.desc_moderation'),
  levels: t('modules.desc_levels'),
  welcome: t('modules.desc_welcome'),
  reaction_roles: t('modules.desc_reaction_roles'),
  boosts: t('modules.desc_boosts'),
  embeds: t('modules.desc_embeds'),
  automod: t('modules.desc_automod'),
  stream_alerts: t('modules.desc_stream_alerts'),
  tickets: t('modules.desc_tickets'),
};

async function getPremiumInfo(id: string) {
  const [rows] = await pool.query(
    `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

async function getGuildModules(id: string) {
  const [rows] = await pool.query(`SELECT modules FROM guild_settings WHERE guild_id = ?`, [id]);
  const row = (rows as any[])[0];
  if (!row) return null;

  const raw = typeof row.modules === 'string' ? JSON.parse(row.modules) : (row.modules ?? {});
  return MODULE_KEYS.map((key) => ({
    key,
    label: MODULE_LABELS[key],
    description: MODULE_DESCRIPTIONS[key],
    enabled: raw[key] ?? false,
    core: key === 'moderation',
  }));
}

const [premium, modules, botInfoResult] = await Promise.all([
  getPremiumInfo(guildId!), 
  getGuildModules(guildId!),
  callGuildAction(Astro, 'guild', 'info', guildId!).catch(() => null),
]);

if (!modules) {
  return Astro.redirect('/server');
}

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
const premiumActive = Boolean(premium);

if (botInfoResult) {
  guildName = botInfoResult.name;
  guildIconUrl = botInfoResult.icon_url;
}

const i18n = {
  saving: t('common.saving'),
  saveChangesBtn: t('modules.save_changes_btn'),
  saved: t('settings.saved'),
  changesCountSingularTemplate: t('modules.changes_count_singular'), // enthält "{count}"
  changesCountPluralTemplate: t('modules.changes_count_plural'), // enthält "{count}"
  unexpectedResponseFullTemplate: t('welcome.unexpected_response_full'), // enthält "{status}"
  serverErrorPrefix: t('welcome.server_error_prefix'),
  serverErrorStatusTemplate: t('welcome.server_error_status'), // enthält "{status}"
};
---

<DashboardLayout title={t('nav.modules')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('nav.modules')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
    {t('modules.subtitle')}
  </p>

  <!-- Save-Bar -->
  <div id="save-bar" class="sticky top-0 z-[70] hidden mb-6">
    <div class="rounded-xl glass-panel px-5 py-3 flex items-center justify-between shadow-lg">
      <span id="save-status" class="text-sm font-medium text-slate-700 dark:text-slate-200">{t('modules.changes_count_plural', { count: 0 })}</span>
      <div class="flex items-center gap-3">
        <button id="discard-btn" type="button" class="text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('settings.discard')}</button>
        <button id="save-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('modules.save_changes_btn')}</button>
      </div>
    </div>
  </div>

  <div id="modules-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pb-20" data-guild-id={guildId}>
    {modules.map((mod) => (
      <div class="rounded-xl glass-panel p-5 transition-all" data-module-card={mod.key} data-initial-enabled={String(mod.enabled)}>
        <div class="flex items-start justify-between mb-3">
          <a href={`/server/${guildId}/modules/${mod.key.replace('_', '-')}/`} class="font-semibold text-slate-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {mod.label}
          </a>
          <button
            type="button" role="switch" aria-checked={mod.enabled}
            disabled={mod.core}
            title={mod.core ? t('modules.core_module_tooltip') : undefined}
            data-module-toggle={mod.key}
            class:list={["relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900", mod.enabled ? "bg-primary-500" : "bg-slate-300 dark:bg-slate-700", { "opacity-50 cursor-not-allowed": mod.core }]}
          >
            <span class:list={["inline-block h-4 w-4 transform rounded-full bg-white transition-transform", mod.enabled ? "translate-x-6" : "translate-x-1"]}></span>
          </button>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{mod.description}</p>
        <div class="flex items-center justify-between">
          <span data-module-badge>
            {mod.core ? (
              <Badge variant="primary">{t('moderation.core_module_badge')}</Badge>
            ) : (
              <Badge variant={mod.enabled ? 'success' : 'neutral'}>{mod.enabled ? t('settings.active_badge') : t('settings.inactive_badge')}</Badge>
            )}
          </span>
          <a href={`/server/${guildId}/modules/${mod.key.replace('_', '-')}/`} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {mod.core ? t('modules.overview_link') : t('modules.settings_link')}
          </a>
        </div>
      </div>
    ))}
  </div>
</DashboardLayout>

<script define:vars={{ guildId, i18n }}>
  function setupModuleToggles() {
    const grid = document.getElementById('modules-grid');
    const saveBar = document.getElementById('save-bar');
    const saveStatus = document.getElementById('save-status');
    const saveBtn = document.getElementById('save-btn');
    const discardBtn = document.getElementById('discard-btn');
    if (!grid || grid.dataset.bound === 'true') return;
    grid.dataset.bound = 'true';

    function getPendingChanges() {
      const changes = {};
      grid.querySelectorAll('[data-module-card]').forEach((card) => {
        const key = card.dataset.moduleCard;
        const initial = card.dataset.initialEnabled === 'true';
        const btn = card.querySelector('[data-module-toggle]');
        const current = btn.getAttribute('aria-checked') === 'true';
        if (current !== initial) changes[key] = current;
      });
      return changes;
    }

    function refreshSaveBar() {
      const changes = getPendingChanges();
      const count = Object.keys(changes).length;
      grid.querySelectorAll('[data-module-card]').forEach((card) => {
        const key = card.dataset.moduleCard;
        const willBeEnabled = changes[key];
        card.classList.remove('ring-2', 'ring-primary-500', 'ring-amber-500');
        if (key in changes) card.classList.add('ring-2', willBeEnabled ? 'ring-primary-500' : 'ring-amber-500');
      });
      saveBar.classList.toggle('hidden', count === 0);
      saveStatus.textContent = (count === 1 ? i18n.changesCountSingularTemplate : i18n.changesCountPluralTemplate).replace('{count}', count);
    }

    grid.querySelectorAll('[data-module-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const next = btn.getAttribute('aria-checked') !== 'true';
        btn.setAttribute('aria-checked', String(next));
        btn.classList.toggle('bg-primary-500', next);
        btn.classList.toggle('bg-slate-300', !next);
        btn.classList.toggle('dark:bg-slate-700', !next);
        const knob = btn.querySelector('span');
        knob?.classList.toggle('translate-x-6', next);
        knob?.classList.toggle('translate-x-1', !next);
        refreshSaveBar();
      });
    });

    discardBtn.addEventListener('click', () => {
      grid.querySelectorAll('[data-module-card]').forEach((card) => {
        const initial = card.dataset.initialEnabled === 'true';
        const btn = card.querySelector('[data-module-toggle]');
        btn.setAttribute('aria-checked', String(initial));
        btn.classList.toggle('bg-primary-500', initial);
        btn.classList.toggle('bg-slate-300', !initial);
        btn.classList.toggle('dark:bg-slate-700', !initial);
        const knob = btn.querySelector('span');
        knob?.classList.toggle('translate-x-6', initial);
        knob?.classList.toggle('translate-x-1', !initial);
      });
      refreshSaveBar();
    });

    saveBtn.addEventListener('click', async () => {
      const changes = getPendingChanges();
      if (Object.keys(changes).length === 0) return;

      saveBtn.disabled = true;
      saveBtn.textContent = i18n.saving;

      try {
        const res = await fetch(`/api/server/${guildId}/module/modules/toggle/`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ changes }),
        });

        let data;
        try {
          data = await res.json();
        } catch {
          throw new Error(i18n.unexpectedResponseFullTemplate.replace('{status}', res.status));
        }
        if (!res.ok || !data.ok) {
          throw new Error(data.error ? `${i18n.serverErrorPrefix}${data.error}` : i18n.serverErrorStatusTemplate.replace('{status}', res.status));
        }

        grid.querySelectorAll('[data-module-card]').forEach((card) => {
          const btn = card.querySelector('[data-module-toggle]');
          card.dataset.initialEnabled = btn.getAttribute('aria-checked') === 'true' ? 'true' : 'false';
        });

        saveStatus.textContent = i18n.saved;
        setTimeout(refreshSaveBar, 1200);
      } catch (err) {
        alert(err.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = i18n.saveChangesBtn;
      }
    });
  }

  setupModuleToggles();
  document.addEventListener('astro:page-load', setupModuleToggles);
</script>
