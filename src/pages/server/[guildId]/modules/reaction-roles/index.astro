---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../../components/Badge.astro';
import { callGuildAction } from '../../../../../lib/botApi';
import { renderDiscordMarkdown } from '../../../../../lib/discordMarkdown';

const { guildId } = Astro.params;
const t = Astro.locals.t;

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let channels: { id: string; name: string }[] = [];
let allRoles: { id: string; name: string }[] = [];
let groups: { id: number; name: string }[] = [];
let messages: {
  message_id: string; channel_id: string; channel_name: string | null;
  title: string; description: string;
  display_mode: 'reaction' | 'dropdown';
  entries: { id: number; emoji: string; role_id: string; role_name: string; mode: string; group_id: number | null }[];
}[] = [];
let customEmojis: { name: string; id: string; animated: boolean; url: string }[] = [];
let premiumActive = false;
let botOnline = true;

try {
  const [info, channelsResult, rolesResult, emojisResult, groupsResult, messagesResult] = await Promise.all([
    callGuildAction(Astro, 'guild', 'info', guildId!),
    callGuildAction(Astro, 'guild', 'channels', guildId!),
    callGuildAction(Astro, 'guild', 'roles', guildId!),
    callGuildAction(Astro, 'guild', 'emojis', guildId!),
    callGuildAction(Astro, 'reaction_roles', 'list-groups', guildId!),
    callGuildAction(Astro, 'reaction_roles', 'list-messages', guildId!),
  ]);

  guildName = info.name;
  guildIconUrl = info.icon_url;
  channels = channelsResult.channels;
  allRoles = rolesResult.roles;
  customEmojis = emojisResult.emojis;
  groups = groupsResult.groups;
  messages = messagesResult.messages;
  premiumActive = messagesResult.premium_active;
} catch {
  botOnline = false;
}

// Texte für das Seiten-Skript (src/scripts/pages/reaction-roles.ts)
const i18n = {
  remove: t('common.remove'),
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('reaction_roles.unexpected_response'),
  roleCountTemplate: t('reaction_roles.role_count'), // enthält "{count}"
  uniqueGroupBadgeTemplate: t('reaction_roles.unique_group_badge'), // enthält "{group}"
  toggleOption: t('reaction_roles.toggle_option'),
  uniqueOption: t('reaction_roles.unique_option'),
  addEntryBtn: t('reaction_roles.add_entry_btn'),
  deleteMessageBtn: t('reaction_roles.delete_message_btn'),
  noEntries: t('reaction_roles.no_entries'),
  alertGroupNameRequired: t('reaction_roles.alert_group_name_required'),
  alertTitleDescRequired: t('reaction_roles.alert_title_desc_required'),
  alertEmojiRequired: t('reaction_roles.alert_emoji_required'),
  alertInvalidEmoji: t('reaction_roles.alert_invalid_emoji'),
  confirmDeleteEntry: t('reaction_roles.confirm_delete_entry'),
  confirmDeleteMessage: t('reaction_roles.confirm_delete_message'),
  displayModeReactionOption: t('reaction_roles.display_mode_reaction_option'),
  displayModeDropdownOption: t('reaction_roles.display_mode_dropdown_option')
};
---

<DashboardLayout title={t('reaction_roles.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <div id="reaction-roles-page" data-config={JSON.stringify({ guildId, i18n })}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('reaction_roles.title')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {t('reaction_roles.subtitle')}
  </p>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  <!-- Gruppen -->
  <section class="rounded-xl glass-panel p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('reaction_roles.groups_title')}</h2>
      <button id="add-group-btn" type="button" disabled={!botOnline} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-50">
        + {t('reaction_roles.new_group_btn')}
      </button>
    </div>

    <div id="groups-list" class="space-y-2">
      {groups.map((g) => {
        const roleCount = messages.flatMap((m) => m.entries).filter((e) => e.group_id === g.id).length;
        return (
          <div class="flex items-center justify-between p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-group-row={g.id}>
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-slate-900 dark:text-white">{g.name}</span>
              <Badge variant="primary">{t('reaction_roles.unique_option')}</Badge>
            </div>
            <span class="text-xs text-slate-400" data-group-role-count>{t('reaction_roles.role_count', { count: roleCount })}</span>
          </div>
        );
      })}
    </div>
    {groups.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-2">{t('reaction_roles.no_groups')}</p>}

    <div id="group-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.group_name_label')}</label>
      <div class="flex gap-2">
        <input type="text" id="new-group-name-input" maxlength="100" placeholder={t('reaction_roles.group_name_placeholder')} class="flex-1 px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
        <button id="confirm-group-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.create')}</button>
        <button id="cancel-group-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
      </div>
    </div>
  </section>

  <!-- Nachrichten -->
  <section class="rounded-xl glass-panel p-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('reaction_roles.messages_title')}</h2>
      <button id="new-message-btn" type="button" disabled={!botOnline} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-50">
        + {t('reaction_roles.new_message_btn')}
      </button>
    </div>

    <div id="messages-list">
      {messages.map((msg) => (
        <div class="mb-5 last:mb-0" data-message-block={msg.message_id}>
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">#{msg.channel_name ?? t('reaction_roles.channel_deleted')}</span>
              <span class="text-xs text-slate-400 font-mono">{msg.message_id}</span>
              <Badge variant={msg.display_mode === 'dropdown' ? 'primary' : 'neutral'}>
                {msg.display_mode === 'dropdown' ? t('reaction_roles.display_mode_dropdown_option') : t('reaction_roles.display_mode_reaction_option')}
              </Badge>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" data-add-entry-to={msg.message_id} data-channel-id={msg.channel_id} disabled={!botOnline} class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline disabled:opacity-50">+ {t('reaction_roles.add_entry_btn')}</button>
              <button type="button" data-delete-message={msg.message_id} data-channel-id={msg.channel_id} disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">{t('reaction_roles.delete_message_btn')}</button>
            </div>
          </div>
          <div class="mb-2">
            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate" data-msg-title>{msg.title}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 italic" data-msg-desc set:html={renderDiscordMarkdown(msg.description)} />
          </div>
          <div class="space-y-2" data-entries-list={msg.message_id}>
            {msg.entries.map((entry) => (
              <div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-entry-row={entry.id} data-emoji={entry.emoji}>
                <span class="text-lg flex-shrink-0 w-8 text-center">{entry.emoji.startsWith('<') ? '🔹' : entry.emoji}</span>
                <div class="flex items-center gap-2 flex-1 min-w-0">
                  <span class="text-sm font-medium text-slate-900 dark:text-white truncate">{entry.role_name}</span>
                </div>
                <Badge variant={entry.mode === 'unique' ? 'primary' : 'neutral'}>
                  {entry.mode === 'unique' ? t('reaction_roles.unique_group_badge', { group: groups.find((g) => g.id === entry.group_id)?.name ?? '?' }) : t('reaction_roles.toggle_option')}
                </Badge>
                <button type="button" data-remove-entry={entry.id} data-message-id={msg.message_id} data-channel-id={msg.channel_id} disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline flex-shrink-0 disabled:opacity-50">{t('common.remove')}</button>
              </div>
            ))}
          </div>
          {msg.entries.length === 0 && <p class="text-sm text-slate-400 py-2">{t('reaction_roles.no_entries')}</p>}
        </div>
      ))}
    </div>
    {messages.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('reaction_roles.no_messages')}</p>}

    <!-- Neue-Nachricht-Form -->
    <div id="new-message-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <p class="text-sm font-semibold text-slate-900 dark:text-white mb-3">{t('reaction_roles.new_message_form_title')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.channel_label')}</label>
          <select id="new-msg-channel" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
            {channels.map((ch) => <option value={ch.id} data-channel-name={ch.name}>#{ch.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.title_label')}</label>
          <input type="text" id="new-msg-title" maxlength="256" placeholder={t('reaction_roles.title_placeholder')} class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.description_label')}</label>

        <div class="flex flex-wrap gap-1 mb-2" data-md-toolbar="new-msg-desc">
          <button type="button" data-md="bold" title={t('tickets.md_bold')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm font-bold">B</button>
          <button type="button" data-md="italic" title={t('tickets.md_italic')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm italic">I</button>
          <button type="button" data-md="underline" title={t('tickets.md_underline')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm underline">U</button>
          <button type="button" data-md="strike" title={t('tickets.md_strike')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm line-through">S</button>
          <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
          <button type="button" data-md="h1" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H1</button>
          <button type="button" data-md="h2" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H2</button>
          <button type="button" data-md="h3" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H3</button>
          <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
          <button type="button" data-md="list" class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm">•</button>
          <button type="button" data-md="code" class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-mono">{'</>'}</button>
          <button type="button" data-md="codeblock" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-mono">{'{ }'}</button>
        </div>

        <textarea id="new-msg-desc" rows="2" maxlength="4000" placeholder={t('reaction_roles.description_placeholder')} class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"></textarea>

        <div class="mt-3 rounded-lg bg-slate-50 dark:bg-slate-800/50 p-3">
          <p class="text-xs text-slate-400 mb-1">{t('tickets.live_preview_label')}</p>
          <p id="new-msg-desc-preview" class="text-sm text-slate-700 dark:text-slate-300 italic">—</p>
        </div>
      </div>
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
          {t('reaction_roles.display_mode_label')} {!premiumActive && <span class="text-xs font-normal text-slate-400">{t('reaction_roles.premium_dropdown_hint')}</span>}
        </label>
        <select id="new-msg-display-mode" class="w-full max-w-xs px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="reaction">{t('reaction_roles.display_mode_reaction_option')}</option>
          <option value="dropdown" disabled={!premiumActive}>{t('reaction_roles.display_mode_dropdown_option')}</option>
        </select>
      </div>
      <div class="flex gap-2">
        <button id="confirm-new-message-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.create')}</button>
        <button id="cancel-new-message-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
      </div>
    </div>

    <!-- Zuordnung-Form -->
    <div id="entry-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <p class="text-sm font-semibold text-slate-900 dark:text-white mb-3">{t('reaction_roles.new_entry_form_title')}</p>

      <div class="mb-3">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.role_label')}</label>
        <select id="entry-role-select" class="w-full max-w-sm px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
          {allRoles.map((r) => <option value={r.id} data-role-name={r.name}>{r.name}</option>)}
        </select>
      </div>

      <div class="mb-3">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
          {t('reaction_roles.emoji_label')} {!premiumActive && <span class="text-xs font-normal text-slate-400">{t('reaction_roles.premium_custom_emoji_hint')}</span>}
        </label>
        <input type="text" id="entry-emoji-input" maxlength="64" placeholder={t('reaction_roles.emoji_placeholder')} class="w-full max-w-sm px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />

        {customEmojis.length > 0 && (
          <div class="mt-2">
            <p class="text-xs text-slate-400 mb-1.5">{t('reaction_roles.server_emojis_label')} {!premiumActive && '🔒'}:</p>
            <div class="flex flex-wrap gap-1.5" id="custom-emoji-picker">
              {customEmojis.slice(0, 30).map((e) => (
                <button
                  type="button"
                  data-custom-emoji={`<${e.animated ? 'a' : ''}:${e.name}:${e.id}>`}
                  disabled={!premiumActive}
                  title={e.name}
                  class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed"
                >
                  <img src={e.url} alt={e.name} class="w-5 h-5" />
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
          {t('reaction_roles.mode_label')} {!premiumActive && <span class="text-xs font-normal text-slate-400">{t('reaction_roles.premium_unique_hint')}</span>}
        </label>
        <select id="entry-mode-select" class="w-full max-w-xs px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="toggle">{t('reaction_roles.toggle_option')}</option>
          <option value="unique" disabled={!premiumActive}>{t('reaction_roles.unique_option')}</option>
        </select>
      </div>

      <div id="entry-group-wrap" class="hidden mb-4">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('reaction_roles.group_label')}</label>
        <select id="entry-group-select" class="w-full max-w-xs px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500">
          <option value="">{t('reaction_roles.no_group_option')}</option>
          {groups.map((g) => <option value={g.id}>{g.name}</option>)}
        </select>
      </div>

      <div class="flex gap-2">
        <button id="confirm-entry-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.save')}</button>
        <button id="cancel-entry-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
      </div>
    </div>
  </section>
  </div>
</DashboardLayout>

<script>
  import '../../../../../scripts/pages/reaction-roles';
</script>
