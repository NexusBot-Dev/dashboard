---
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../../components/Badge.astro';
import { callGuildAction } from '../../../../../lib/botApi';

const { guildId } = Astro.params;
const t = Astro.locals.t;

let guildName = `Server ${guildId}`;
let guildIconUrl: string | null = null;
let channels: { id: string; name: string }[] = [];
let allRoles: { id: string; name: string }[] = [];
let categories: { id: number; name: string; role_ids: string[]; roles: { id: string; name: string }[] }[] = [];
let openTickets: { id: number; ticket_number: number; status: string; category_name: string; user_tag: string; channel_id: string }[] = [];
let limitFree = 2;
let limitPremium = 10;
let premiumActive = false;
let botOnline = true;

try {
  const [info, channelsResult, rolesResult, catResult, openResult] = await Promise.all([
    callGuildAction(Astro, 'guild', 'info', guildId!),
    callGuildAction(Astro, 'guild', 'channels', guildId!),
    callGuildAction(Astro, 'guild', 'roles', guildId!),
    callGuildAction(Astro, 'tickets', 'list-categories', guildId!),
    callGuildAction(Astro, 'tickets', 'list-open', guildId!),
  ]);

  guildName = info.name;
  guildIconUrl = info.icon_url;
  channels = channelsResult.channels;
  allRoles = rolesResult.roles;
  categories = catResult.categories;
  limitFree = catResult.limit_free;
  limitPremium = catResult.limit_premium;
  premiumActive = catResult.premium_active;
  openTickets = openResult.tickets;
} catch {
  botOnline = false;
}

const limit = premiumActive ? limitPremium : limitFree;
const statusLabel: Record<string, string> = {
  open: t('tickets.status_open'),
  pending_closure: t('tickets.status_pending_closure'),
};
const statusVariant: Record<string, 'success' | 'warning'> = { open: 'success', pending_closure: 'warning' };

const i18n = {
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('tickets.unexpected_response'),
  categoryFormAddTitle: t('tickets.category_form_add_title'),
  categoryFormEditTitle: t('tickets.category_form_edit_title'),
  accessPrefixTemplate: t('tickets.access_prefix'), // enthält "{names}"
  adminsOnly: t('tickets.admins_only'),
  edit: t('common.edit'),
  delete: t('common.delete'),
  alertNameRequired: t('tickets.alert_name_required'),
  confirmDeleteCategory: t('tickets.confirm_delete_category'),
  alertTitleDescRequired: t('tickets.alert_title_desc_required'),
  confirmPostPanelTemplate: t('tickets.confirm_post_panel'), // enthält "{channel}"
  alertPanelPosted: t('tickets.alert_panel_posted'),
};
---

<DashboardLayout title={t('tickets.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('tickets.title')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {t('tickets.subtitle')}
  </p>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  <!-- Ticket-Log-Channel -->
  <section class="rounded-xl glass-panel p-6 mb-6">
    <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.log_channel_title')}</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{t('tickets.log_channel_desc')}</p>
    <a href={`/server/${guildId}/settings/`} class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline">{t('tickets.configure_in_settings')}</a>
  </section>

  <!-- Kategorien -->
  <section class="rounded-xl glass-panel p-6 mb-6">
    <div class="flex items-center justify-between mb-1">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('tickets.categories_title')}</h2>
      <button id="add-category-btn" type="button" disabled={!botOnline || categories.length >= limit} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
        + {t('common.create')}
      </button>
    </div>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">
      {t('tickets.categories_count', { count: categories.length, limit })}
      {!premiumActive && categories.length >= limitFree && (
        <span class="ml-1">— <Badge variant="primary">Premium</Badge> {t('tickets.premium_hint', { max: limitPremium })}</span>
      )}
    </p>

    <div id="categories-list" class="space-y-2">
      {categories.map((cat) => (
        <div class="p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-category-row={cat.id} data-role-ids={JSON.stringify(cat.role_ids)}>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-slate-900 dark:text-white" data-category-name>{cat.name}</span>
            <div class="flex items-center gap-3 flex-shrink-0">
              <button type="button" data-edit-category={cat.id} disabled={!botOnline} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline disabled:opacity-50">{t('common.edit')}</button>
              <button type="button" data-remove-category={cat.id} disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">{t('common.delete')}</button>
            </div>
          </div>
          <p class="mt-1 text-xs text-slate-400" data-category-roles-label>
            {cat.roles.length > 0 ? t('tickets.access_prefix', { names: cat.roles.map((r) => r.name).join(', ') }) : t('tickets.admins_only')}
          </p>
        </div>
      ))}
    </div>
    {categories.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('tickets.no_categories')}</p>}

    <div id="category-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <p id="category-form-title" class="text-sm font-semibold text-slate-900 dark:text-white mb-3">{t('tickets.category_form_add_title')}</p>
      <div class="mb-3">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('tickets.name_label')}</label>
        <input type="text" id="category-name-input" maxlength="100" placeholder={t('tickets.name_placeholder')} class="w-full max-w-sm px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
      </div>
      <div class="mb-4">
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('tickets.allowed_roles_label')}</label>
        <div class="flex flex-wrap gap-2" id="role-checkboxes">
          {allRoles.map((r) => (
            <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 cursor-pointer has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 dark:has-[:checked]:bg-primary-950 text-sm">
              <input type="checkbox" data-role-checkbox value={r.id} class="accent-primary-600" />
              {r.name}
            </label>
          ))}
        </div>
      </div>
      <div class="flex gap-2">
        <button id="confirm-category-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.save')}</button>
        <button id="cancel-category-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
      </div>
      <p class="mt-2 text-xs text-slate-400">{t('tickets.category_form_note')}</p>
    </div>
  </section>

  <!-- Panel posten -->
  <section class="rounded-xl glass-panel p-6 mb-6">
    <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.panel_section_title')}</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-2">{t('tickets.panel_section_desc')}</p>
    <p class="text-xs text-amber-600 dark:text-amber-400 mb-4">
      {t('tickets.panel_warning')}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('tickets.target_channel_label')}</label>
        <select id="panel-channel-select" disabled={!botOnline} class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50">
          {channels.map((ch) => <option value={ch.id}>#{ch.name}</option>)}
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('tickets.title_label')}</label>
        <input type="text" id="panel-title-input" maxlength="256" value="🎫 Support" class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500" />
      </div>
    </div>
    <div class="mb-4">
      <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">{t('tickets.description_label')}</label>
      <div class="flex flex-wrap gap-1 mb-2" data-md-toolbar="tickets-textarea">
        <button type="button" data-md="bold" title={t('tickets.md_bold')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm font-bold">B</button>
        <button type="button" data-md="italic" title={t('tickets.md_italic')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm italic">I</button>
        <button type="button" data-md="underline" title={t('tickets.md_underline')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm underline">U</button>
        <button type="button" data-md="strike" title={t('tickets.md_strike')} class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm line-through">S</button>
        <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
        <button type="button" data-md="h1" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H1</button>
        <button type="button" data-md="h2" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H2</button>
        <button type="button" data-md="h3" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold">H3</button>
        <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
        <button type="button" data-md="list" class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm">•</button>
        <button type="button" data-md="code" class="w-8 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-mono">{'</>'}</button>
        <button type="button" data-md="codeblock" class="px-2 h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-mono">{'{ }'}</button>
      </div>
      <textarea id="tickets-textarea" rows="3" maxlength="1000" placeholder={t('tickets.description_placeholder')} class="w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none"></textarea>
      <div class="mt-3 rounded-lg bg-slate-50 dark:bg-slate-800/50 p-3">
        <p class="text-xs text-slate-400 mb-1">{t('tickets.live_preview_label')}</p>
        <p id="tickets-preview" class="text-sm text-slate-700 dark:text-slate-300 italic">—</p>
      </div>
    </div>
    <button id="post-panel-btn" type="button" disabled={!botOnline || categories.length === 0} class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
      {t('tickets.post_panel_btn')}
    </button>
  </section>

  <!-- Offene Tickets -->
  <section class="rounded-xl glass-panel p-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('tickets.open_tickets_title')}</h2>
      <span class="text-sm text-slate-500 dark:text-slate-400">{openTickets.length} {openTickets.length === 1 ? t('tickets.ticket_singular') : t('tickets.ticket_plural')}</span>
    </div>
    <div class="space-y-2">
      {openTickets.map((t2) => (
        <div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800">
          <span class="text-sm font-mono text-slate-400 flex-shrink-0">#{t2.ticket_number}</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-slate-900 dark:text-white truncate">{t2.user_tag}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">{t2.category_name}</p>
          </div>
          <Badge variant={statusVariant[t2.status] ?? 'neutral'}>{statusLabel[t2.status] ?? t2.status}</Badge>
        </div>
      ))}
    </div>
    {openTickets.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('tickets.no_open_tickets')}</p>}
  </section>
</DashboardLayout>

<script define:vars={{ guildId, i18n }}>
async function callModuleAction(module, action, body = {}) {
  const res = await fetch(`/api/server/${guildId}/module/${module}/${action}/`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  let data;
  try { data = await res.json(); } catch { throw new Error(i18n.unexpectedResponseTemplate.replace('{status}', res.status)); }
  if (!res.ok || !data.ok) throw new Error(data.error ? `${i18n.errorGeneric}: ${data.error}` : i18n.errorServerTemplate.replace('{status}', res.status));
  return data.data;
}

function renderDiscordMarkdown(text) {
  let out = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const codeBlocks = [];
  out = out.replace(/```([\s\S]*?)```/g, (_, code) => { codeBlocks.push(code); return `%%CB${codeBlocks.length - 1}%%`; });
  out = out.replace(/`([^`\n]+)`/g, '<code class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-xs">$1</code>');
  out = out.replace(/__\*\*\*(.+?)\*\*\*__/g, '<u><strong><em>$1</em></strong></u>');
  out = out.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
  out = out.replace(/__\*\*(.+?)\*\*__/g, '<u><strong>$1</strong></u>');
  out = out.replace(/__\*(.+?)\*__/g, '<u><em>$1</em></u>');
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/__(.+?)__/g, '<u>$1</u>');
  out = out.replace(/\*(.+?)\*/g, '<em>$1</em>');
  out = out.replace(/(?<!\w)_(.+?)_(?!\w)/g, '<em>$1</em>');
  out = out.replace(/~~(.+?)~~/g, '<del>$1</del>');
  out = out.split('\n').map((line) => {
    if (/^### (.+)/.test(line)) return line.replace(/^### (.+)/, '<span class="text-sm font-bold">$1</span>');
    if (/^## (.+)/.test(line)) return line.replace(/^## (.+)/, '<span class="text-base font-bold">$1</span>');
    if (/^# (.+)/.test(line)) return line.replace(/^# (.+)/, '<span class="text-lg font-bold">$1</span>');
    if (/^\s{0,2}[-*] (.+)/.test(line)) return line.replace(/^\s{0,2}[-*] (.+)/, '• $1');
    return line;
  }).join('\n');
  out = out.replace(/%%CB(\d+)%%/g, (_, i) => `<pre class="bg-slate-200 dark:bg-slate-700 rounded p-2 text-xs overflow-x-auto my-1"><code>${codeBlocks[Number(i)]}</code></pre>`);
  return out.replace(/\n/g, '<br>');
}

function renderPreview(text) {
  return renderDiscordMarkdown(text);
}

function wrapSelection(ta, before, after = before) {
  const start = ta.selectionStart, end = ta.selectionEnd;
  const val = ta.value;
  const selected = val.slice(start, end);
  ta.value = val.slice(0, start) + before + selected + after + val.slice(end);
  ta.selectionStart = start + before.length;
  ta.selectionEnd = start + before.length + selected.length;
  ta.dispatchEvent(new Event('input', { bubbles: true }));
  ta.focus();
}
function prefixLines(ta, prefix) {
  const start = ta.selectionStart, end = ta.selectionEnd;
  const val = ta.value;
  const lineStart = val.lastIndexOf('\n', start - 1) + 1;
  let lineEnd = val.indexOf('\n', end);
  if (lineEnd === -1) lineEnd = val.length;
  const block = val.slice(lineStart, lineEnd);
  const newBlock = block.split('\n').map((l) => prefix + l).join('\n');
  ta.value = val.slice(0, lineStart) + newBlock + val.slice(lineEnd);
  ta.dispatchEvent(new Event('input', { bubbles: true }));
  ta.focus();
}
function setupMarkdownToolbars() {
  document.querySelectorAll('[data-md-toolbar]').forEach((toolbar) => {
    if (toolbar.dataset.bound === 'true') return;
    toolbar.dataset.bound = 'true';
    const ta = document.getElementById(toolbar.dataset.mdToolbar);
    if (!ta) return;
    toolbar.querySelectorAll('[data-md]').forEach((btn) => {
      btn.addEventListener('click', () => {
        switch (btn.dataset.md) {
          case 'bold': wrapSelection(ta, '**'); break;
          case 'italic': wrapSelection(ta, '*'); break;
          case 'underline': wrapSelection(ta, '__'); break;
          case 'strike': wrapSelection(ta, '~~'); break;
          case 'code': wrapSelection(ta, '`'); break;
          case 'codeblock': wrapSelection(ta, '```\n', '\n```'); break;
          case 'h1': prefixLines(ta, '# '); break;
          case 'h2': prefixLines(ta, '## '); break;
          case 'h3': prefixLines(ta, '### '); break;
          case 'list': prefixLines(ta, '- '); break;
        }
      });
    });
  });
}

function setupTicketsPreview() {
  const textarea = document.getElementById('tickets-textarea');
  const previewEl = document.getElementById('tickets-preview');
  if (!textarea || !previewEl || textarea.dataset.previewBound === 'true') return;
  textarea.dataset.previewBound = 'true';

  textarea.addEventListener('input', () => {
    const val = textarea.value.trim();
    previewEl.innerHTML = val ? renderPreview(val) : '—';
  });
}

function setupCategories() {
  const addBtn = document.getElementById('add-category-btn');
  const form = document.getElementById('category-form');
  const formTitle = document.getElementById('category-form-title');
  const nameInput = document.getElementById('category-name-input');
  const confirmBtn = document.getElementById('confirm-category-btn');
  const cancelBtn = document.getElementById('cancel-category-btn');
  const list = document.getElementById('categories-list');

  if (!addBtn || addBtn.dataset.bound === 'true') return;
  addBtn.dataset.bound = 'true';

  let editingId = null;

  function currentCount() { return list.querySelectorAll('[data-category-row]').length; }

  function openForm(mode, row) {
    editingId = mode === 'edit' ? row.dataset.categoryRow : null;
    formTitle.textContent = mode === 'edit' ? i18n.categoryFormEditTitle : i18n.categoryFormAddTitle;
    nameInput.value = mode === 'edit' ? row.querySelector('[data-category-name]').textContent : '';
    nameInput.disabled = mode === 'edit'; // Umbenennen läuft separat, hier nur Rollen bei "edit"

    const checkedIds = mode === 'edit' ? JSON.parse(row.dataset.roleIds || '[]') : [];
    form.querySelectorAll('[data-role-checkbox]').forEach((cb) => { cb.checked = checkedIds.includes(cb.value); });

    form.classList.remove('hidden');
    nameInput.focus();
  }
  function closeForm() { form.classList.add('hidden'); editingId = null; nameInput.disabled = false; }

  addBtn.addEventListener('click', () => { if (currentCount() >= addBtn.dataset.limit) return; openForm('add'); });
  cancelBtn.addEventListener('click', closeForm);

  confirmBtn.addEventListener('click', async () => {
    const roleIds = Array.from(form.querySelectorAll('[data-role-checkbox]:checked')).map((cb) => cb.value);

    confirmBtn.disabled = true;
    try {
      if (editingId) {
        const result = await callModuleAction('tickets', 'set-category-roles', { category_id: Number(editingId), role_ids: roleIds });
        const row = list.querySelector(`[data-category-row="${editingId}"]`);
        row.dataset.roleIds = JSON.stringify(result.roles.map((r) => r.id));
        row.querySelector('[data-category-roles-label]').textContent = result.roles.length > 0
          ? i18n.accessPrefixTemplate.replace('{names}', result.roles.map((r) => r.name).join(', '))
          : i18n.adminsOnly;
      } else {
        const name = nameInput.value.trim();
        if (!name) { alert(i18n.alertNameRequired); confirmBtn.disabled = false; return; }

        const result = await callModuleAction('tickets', 'create-category', { name, role_ids: roleIds });
        const row = document.createElement('div');
        row.className = 'p-3 rounded-lg border border-slate-200 dark:border-slate-800';
        row.dataset.categoryRow = String(result.id);
        row.dataset.roleIds = JSON.stringify(roleIds);

        const roleNames = Array.from(form.querySelectorAll('[data-role-checkbox]:checked')).map((cb) => cb.parentElement.textContent.trim());
        row.innerHTML = `
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-slate-900 dark:text-white" data-category-name></span>
            <div class="flex items-center gap-3 flex-shrink-0">
              <button type="button" data-edit-category="${result.id}" class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline">${i18n.edit}</button>
              <button type="button" data-remove-category="${result.id}" class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline">${i18n.delete}</button>
            </div>
          </div>
          <p class="mt-1 text-xs text-slate-400" data-category-roles-label></p>
        `;
        row.querySelector('[data-category-name]').textContent = name;
        row.querySelector('[data-category-roles-label]').textContent = roleNames.length > 0
          ? i18n.accessPrefixTemplate.replace('{names}', roleNames.join(', '))
          : i18n.adminsOnly;
        list.appendChild(row);
        bindRowButtons(row);
      }
      closeForm();
    } catch (err) {
      alert(err.message);
    } finally {
      confirmBtn.disabled = false;
    }
  });

  function bindRowButtons(row) {
    const editBtn = row.querySelector('[data-edit-category]');
    const removeBtn = row.querySelector('[data-remove-category]');
    if (editBtn && editBtn.dataset.bound !== 'true') {
      editBtn.dataset.bound = 'true';
      editBtn.addEventListener('click', () => openForm('edit', row));
    }
    if (removeBtn && removeBtn.dataset.bound !== 'true') {
      removeBtn.dataset.bound = 'true';
      removeBtn.addEventListener('click', async () => {
        if (!confirm(i18n.confirmDeleteCategory)) return;
        try {
          await callModuleAction('tickets', 'delete-category', { category_id: Number(row.dataset.categoryRow) });
          row.remove();
        } catch (err) {
          alert(err.message);
        }
      });
    }
  }
  document.querySelectorAll('[data-category-row]').forEach(bindRowButtons);
}

function setupPanel() {
  const btn = document.getElementById('post-panel-btn');
  const channelSelect = document.getElementById('panel-channel-select');
  const titleInput = document.getElementById('panel-title-input');
  const descInput = document.getElementById('tickets-textarea'); // war fälschlich 'panel-desc-input'
  if (!btn || btn.dataset.bound === 'true') return;
  btn.dataset.bound = 'true';

  btn.addEventListener('click', async () => {
    const title = titleInput.value.trim();
    const description = descInput.value.trim();
    if (!title || !description) { alert(i18n.alertTitleDescRequired); return; }

    const channelOpt = channelSelect.selectedOptions[0];
    if (!confirm(i18n.confirmPostPanelTemplate.replace('{channel}', channelOpt.textContent.replace('#', '')))) return;

    btn.disabled = true;
    try {
      await callModuleAction('tickets', 'post-panel', { channel_id: channelSelect.value, title, description });
      alert(i18n.alertPanelPosted);
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  });
}

setupCategories();
setupPanel();
setupMarkdownToolbars();
setupTicketsPreview();
document.addEventListener('astro:page-load', () => {
  setupCategories();
  setupPanel();
  setupMarkdownToolbars();
  setupTicketsPreview();
});
</script>
