---
// Welcome & Boosts — eine Seite mit Tabs (Welcome · Goodbye · Boosts).
// Im Bot bleiben es getrennte Module (welcome, boosts) mit eigenen Schaltern in der Modul-Übersicht.
import DashboardLayout from '../../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../../components/Badge.astro';
import Tabs from '../../../../../components/Tabs.astro';
import MessageListEditor from '../../../../../components/MessageListEditor.astro';
import pool from '../../../../../lib/db';
import { callGuildAction } from '../../../../../lib/botApi';
import { renderPreview } from '../../../../../lib/discordMarkdown';
import { intlLocale } from '../../../../../i18n';

const { guildId } = Astro.params;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

async function getGuildSettings(id: string) {
  const [rows] = await pool.query(
    `SELECT guild_id, welcome_channel_id, goodbye_channel_id, goodbye_enabled, boost_channel_id
     FROM guild_settings WHERE guild_id = ?`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

async function getPremiumInfo(id: string) {
  const [rows] = await pool.query(
    `SELECT expires_at FROM premium WHERE guild_id = ? AND (expires_at IS NULL OR expires_at > NOW())`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

type MessageList = { messages: { id: number; message: string }[]; limit_free: number; limit_premium: number };
const EMPTY_LIST: MessageList = { messages: [], limit_free: 1, limit_premium: 5 };

const botInfoPromise = (async () => {
  try {
    const [info, channelsResult, welcomeList, boostList] = await Promise.all([
      callGuildAction(Astro, 'guild', 'info', guildId!),
      callGuildAction(Astro, 'guild', 'channels', guildId!),
      callGuildAction(Astro, 'welcome', 'list', guildId!),
      callGuildAction(Astro, 'boosts', 'list', guildId!),
    ]);
    return { ok: true as const, info, channels: channelsResult.channels as { id: string; name: string }[], welcomeList: welcomeList as MessageList, boostList: boostList as MessageList };
  } catch {
    return { ok: false as const };
  }
})();

const [settings, premium, botResult] = await Promise.all([getGuildSettings(guildId!), getPremiumInfo(guildId!), botInfoPromise]);

if (!settings) {
  return Astro.redirect('/server');
}

const botOnline = botResult.ok;
const guildName = botResult.ok ? botResult.info.name : `Server ${guildId}`;
const guildIconUrl: string | null = botResult.ok ? botResult.info.icon_url : null;
const channels = botResult.ok ? botResult.channels : [];
const welcomeList = botResult.ok ? botResult.welcomeList : EMPTY_LIST;
const boostList = botResult.ok ? botResult.boostList : EMPTY_LIST;
const boostTier: number = botResult.ok ? botResult.info.boost_tier : 0;
const boostCount: number = botResult.ok ? botResult.info.boost_count : 0;

const premiumActive = Boolean(premium);
const welcomeChannelName = channels.find((ch) => ch.id === settings.welcome_channel_id)?.name ?? null;
const goodbyeEnabled = Boolean(settings.goodbye_enabled);

// Beispielwerte für die Vorschau — Server und Skript nutzen dieselben, damit beide gleich aussehen
const session = Astro.locals.session;
const displayName = session?.globalName || session?.username || 'User';
const baseVars = { user: `@${displayName}`, username: displayName, server: guildName };
const welcomeVars = { ...baseVars, membercount: (1284).toLocaleString(intlLocale(lang)) };
const boostVars = { ...baseVars, count: String(boostCount) };

const tabs = [
  { key: 'welcome', label: t('welcome.title') },
  { key: 'goodbye', label: t('welcome.goodbye_title') },
  { key: 'boosts', label: t('boost.title') },
];

// Texte für das Seiten-Skript (src/scripts/pages/welcome.ts)
const i18n = {
  save: t('common.save'),
  saving: t('common.saving'),
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('boost.unexpected_response'),
};

const SELECT = 'w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50';
const SAVE_BTN = 'px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
const LABEL = 'block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5';
---

<DashboardLayout title={t('nav.module_welcome')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-6">{t('nav.module_welcome')}</h1>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  <div id="welcome-page" data-config={JSON.stringify({ guildId, i18n })}>
    <Tabs tabs={tabs} label={t('nav.module_welcome')} />

    <!-- ═══ Welcome ═══ -->
    <div role="tabpanel" id="tab-panel-welcome" aria-labelledby="tab-welcome" data-tab-panel="welcome">
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">{t('welcome.subtitle')}</p>

      <section class="rounded-xl glass-panel p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-3" data-channel-setting="welcome_channel_id">
          <div class="flex-1 max-w-xs">
            <label for="welcome-channel-select" class={LABEL}>{t('welcome.welcome_channel_label')}</label>
            <select id="welcome-channel-select" data-initial={settings.welcome_channel_id ?? ''} disabled={!botOnline} class={SELECT}>
              <option value="">{t('common.no_channel')}</option>
              {channels.map((ch) => <option value={ch.id} selected={ch.id === settings.welcome_channel_id}>#{ch.name}</option>)}
            </select>
          </div>
          <button type="button" data-role="save" disabled class={SAVE_BTN}>{t('common.save')}</button>
          <a href={`/server/${guildId}/settings/`} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline self-center sm:self-end sm:mb-2.5">
            {t('welcome.also_in_settings')}
          </a>
        </div>
      </section>

      <MessageListEditor
        module="welcome" textKey="welcome"
        messages={welcomeList.messages} limitFree={welcomeList.limit_free} limitPremium={welcomeList.limit_premium}
        premiumActive={premiumActive} botOnline={botOnline}
        defaultMessage={t('welcome.default_welcome_message')} previewVars={welcomeVars}
      />
    </div>

    <!-- ═══ Goodbye ═══ -->
    <div role="tabpanel" id="tab-panel-goodbye" aria-labelledby="tab-goodbye" data-tab-panel="goodbye" class="hidden">
      <section class="rounded-xl glass-panel p-6">
        <div class="py-2">
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-2">{t('welcome.goodbye_message_intro')}</p>
          <div class="rounded-lg border border-slate-200 dark:border-slate-800 border-dashed p-4">
            <p class="text-sm text-slate-600 dark:text-slate-400 italic" set:html={renderPreview(t('welcome.default_goodbye_message'), welcomeVars)} />
          </div>
        </div>

        <div class="flex items-center justify-between gap-4 mb-4">
          <p class="text-sm font-medium text-slate-900 dark:text-white">{t('welcome.enabled_label')}</p>
          <button
            type="button"
            role="switch"
            id="goodbye-toggle"
            aria-checked={goodbyeEnabled}
            data-initial={String(goodbyeEnabled)}
            disabled={!botOnline}
            class:list={["relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 disabled:opacity-50", goodbyeEnabled ? "bg-primary-500" : "bg-slate-300 dark:bg-slate-700"]}
          >
            <span class:list={["inline-block h-4 w-4 transform rounded-full bg-white transition-transform", goodbyeEnabled ? "translate-x-6" : "translate-x-1"]}></span>
          </button>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-end gap-3">
          <div class="flex-1 max-w-xs">
            <label for="goodbye-channel-select" class={LABEL}>{t('welcome.goodbye_channel_label')}</label>
            <select id="goodbye-channel-select" data-initial={settings.goodbye_channel_id ?? ''} disabled={!botOnline} class={SELECT}>
              <option value="">{t('common.no_channel')}</option>
              {channels.map((ch) => <option value={ch.id} selected={ch.id === settings.goodbye_channel_id}>#{ch.name}</option>)}
            </select>
          </div>
          <button id="save-goodbye-btn" type="button" disabled class={SAVE_BTN}>{t('common.save')}</button>
        </div>
      </section>
    </div>

    <!-- ═══ Boosts ═══ -->
    <div role="tabpanel" id="tab-panel-boosts" aria-labelledby="tab-boosts" data-tab-panel="boosts" class="hidden">
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">{t('boost.subtitle')}</p>

      <section class="rounded-xl glass-panel p-6 mb-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-primary-100 dark:bg-primary-900/30">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-primary-600 dark:text-primary-400">
                <path d="M12 2 3 14h6l-1 8 10-14h-6z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{boostCount} {boostCount === 1 ? t('boost.boost_singular') : t('boost.boost_plural')}</p>
              <p class="text-sm text-slate-500 dark:text-slate-400">{t('boost.server_level', { tier: boostTier })}</p>
            </div>
          </div>
          <Badge variant={boostTier > 0 ? 'primary' : 'neutral'}>{t('boost.level_badge', { tier: boostTier })}</Badge>
        </div>
      </section>

      <section class="rounded-xl glass-panel p-6 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-end gap-3" data-channel-setting="boost_channel_id">
          <div class="flex-1 max-w-xs">
            <label for="boost-channel-select" class={LABEL}>{t('boost.boost_channel_label')}</label>
            <select id="boost-channel-select" data-initial={settings.boost_channel_id ?? ''} disabled={!botOnline} class={SELECT}>
              <!-- Ohne eigenen Boost-Channel nutzt der Bot den Welcome-Channel (cogs/boosts.py) — das sichtbar machen -->
              <option value="">{welcomeChannelName ? t('boost.same_as_welcome', { channel: `#${welcomeChannelName}` }) : t('common.no_channel')}</option>
              {channels.map((ch) => (
                <option value={ch.id} selected={ch.id === settings.boost_channel_id}>#{ch.name}</option>
              ))}
            </select>
          </div>
          <button type="button" data-role="save" disabled class={SAVE_BTN}>{t('common.save')}</button>
        </div>
      </section>

      <MessageListEditor
        module="boosts" textKey="boost"
        messages={boostList.messages} limitFree={boostList.limit_free} limitPremium={boostList.limit_premium}
        premiumActive={premiumActive} botOnline={botOnline}
        defaultMessage={t('boost.default_message')} previewVars={boostVars} rows={3}
      />
    </div>
  </div>
</DashboardLayout>

<script>
  import '../../../../../scripts/pages/welcome';
</script>
