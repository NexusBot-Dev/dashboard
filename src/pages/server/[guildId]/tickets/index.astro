---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import Badge from '../../../../components/Badge.astro';
import pool from '../../../../lib/db';
import { callGuildAction } from '../../../../lib/botApi';
import { renderPreview as baseRenderPreview } from '../../../../lib/discordMarkdown';

const { guildId } = Astro.params;
const t = Astro.locals.t;

type Channel = { id: string; name: string };
type Role = { id: string; name: string };
type Category = { id: number; name: string; role_ids: string[]; roles: Role[] };
type OpenTicket = { id: number; ticket_number: number; status: string; category_name: string; user_tag: string; channel_id: string };

// Modul-Status und Log-Channel kommen direkt aus der DB — so funktioniert die Anzeige auch bei offline Bot
async function getGuildRow(id: string) {
  const [rows] = await pool.query(
    `SELECT modules, ticket_log_channel_id FROM guild_settings WHERE guild_id = ?`,
    [id]
  );
  return (rows as any[])[0] ?? null;
}

async function loadBotData() {
  try {
    const [info, channelsResult, rolesResult, catResult, openResult, settingsResult] = await Promise.all([
      callGuildAction(Astro, 'guild', 'info', guildId!),
      callGuildAction(Astro, 'guild', 'channels', guildId!),
      callGuildAction(Astro, 'guild', 'roles', guildId!),
      callGuildAction(Astro, 'tickets', 'list-categories', guildId!),
      callGuildAction(Astro, 'tickets', 'list-open', guildId!),
      callGuildAction(Astro, 'tickets', 'get-settings', guildId!),
    ]);
    return { info, channelsResult, rolesResult, catResult, openResult, settingsResult };
  } catch {
    return null;
  }
}

const [guildRow, botData] = await Promise.all([getGuildRow(guildId!), loadBotData()]);

if (!guildRow) {
  return Astro.redirect('/server');
}

let moduleStates: Record<string, boolean> = {};
try {
  moduleStates = typeof guildRow.modules === 'string' ? JSON.parse(guildRow.modules) : (guildRow.modules ?? {});
} catch {
  moduleStates = {};
}
const moduleEnabled = moduleStates.tickets ?? false;
const logChannelId: string | null = guildRow.ticket_log_channel_id ? String(guildRow.ticket_log_channel_id) : null;

const botOnline = botData !== null;
const guildName: string = botData?.info.name ?? `Server ${guildId}`;
const guildIconUrl: string | null = botData?.info.icon_url ?? null;
const channels: Channel[] = botData?.channelsResult.channels ?? [];
const allRoles: Role[] = botData?.rolesResult.roles ?? [];
const categories: Category[] = botData?.catResult.categories ?? [];
const openTickets: OpenTicket[] = botData?.openResult.tickets ?? [];
const limitFree: number = botData?.catResult.limit_free ?? 2;
const limitPremium: number = botData?.catResult.limit_premium ?? 10;
const premiumActive: boolean = botData?.catResult.premium_active ?? false;
const limit = premiumActive ? limitPremium : limitFree;

// Panel & Fristen (get-settings)
const ts = botData?.settingsResult ?? null;
const panelChannelId: string | null = ts?.panel_channel_id ?? null;
const panelMessageId: string | null = ts?.panel_message_id ?? null;
const hasPanel = Boolean(panelChannelId && panelMessageId);
const panelWasDeleted = Boolean(panelChannelId && !panelMessageId);
const panelChannel = channels.find((c) => c.id === panelChannelId);
const panelLink = hasPanel ? `https://discord.com/channels/${guildId}/${panelChannelId}/${panelMessageId}` : null;
const panelTitle: string = ts?.panel_title ?? '🎫 Support';
const panelDescription: string = ts?.panel_description ?? '';

const closureHours: number | null = ts?.closure_timeout_hours ?? null;
const deletionHours: number | null = ts?.deletion_delay_hours ?? null;
// Falls ein Wert in der DB steht, der (noch) nicht in der Auswahlliste ist, trotzdem anzeigen
const withCurrent = (options: number[], current: number | null) =>
  current !== null && !options.includes(current) ? [current, ...options] : options;
const closureOptions = withCurrent(ts?.closure_options ?? [], closureHours);
const deletionOptions = withCurrent(ts?.deletion_options ?? [], deletionHours);

const durationLabel = (h: number) =>
  h % 24 === 0
    ? (h === 24 ? t('tickets.duration_day_one') : t('tickets.duration_days', { count: h / 24 }))
    : (h === 1 ? t('tickets.duration_hour_one') : t('tickets.duration_hours', { count: h }));

const statusLabel: Record<string, string> = {
  open: t('tickets.status_open'),
  pending_closure: t('tickets.status_pending_closure'),
};
const statusVariant: Record<string, 'success' | 'warning'> = { open: 'success', pending_closure: 'warning' };

// Tabs — der erste ist der Standard, per Hash (#panel, #categories, #settings) direkt ansteuerbar
const TAB_ACTIVE = 'border-primary-500 text-primary-600 dark:text-primary-400';
const TAB_INACTIVE = 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
const tabs = [
  { key: 'overview', label: t('tickets.tab_overview') },
  { key: 'panel', label: t('tickets.tab_panel') },
  { key: 'categories', label: t('tickets.tab_categories') },
  { key: 'settings', label: t('tickets.tab_settings') },
];

const inputClass = 'w-full px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-50';
const labelClass = 'block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5';
const mdBtnClass = 'h-8 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800';
const mdButtons = [
  { md: 'bold', label: 'B', title: t('tickets.md_bold'), cls: 'w-8 text-sm font-bold' },
  { md: 'italic', label: 'I', title: t('tickets.md_italic'), cls: 'w-8 text-sm italic' },
  { md: 'underline', label: 'U', title: t('tickets.md_underline'), cls: 'w-8 text-sm underline' },
  { md: 'strike', label: 'S', title: t('tickets.md_strike'), cls: 'w-8 text-sm line-through' },
  { sep: true },
  { md: 'h1', label: 'H1', cls: 'px-2 text-xs font-bold' },
  { md: 'h2', label: 'H2', cls: 'px-2 text-xs font-bold' },
  { md: 'h3', label: 'H3', cls: 'px-2 text-xs font-bold' },
  { sep: true },
  { md: 'list', label: '•', cls: 'w-8 text-sm' },
  { md: 'code', label: '</>', cls: 'w-8 text-xs font-mono' },
  { md: 'codeblock', label: '{ }', cls: 'px-2 text-xs font-mono' },
];

const i18n = {
  errorGeneric: t('common.error_generic'),
  errorServerTemplate: t('common.error_server'),
  unexpectedResponseTemplate: t('tickets.unexpected_response'),
  saving: t('common.saving'),
  save: t('common.save'),
  categoryFormAddTitle: t('tickets.category_form_add_title'),
  categoryFormEditTitle: t('tickets.category_form_edit_title'),
  alertNameRequired: t('tickets.alert_name_required'),
  confirmDeleteCategory: t('tickets.confirm_delete_category'),
  alertTitleDescRequired: t('tickets.alert_title_desc_required'),
  confirmPostPanelTemplate: t('tickets.confirm_post_panel'), // enthält "{channel}"
  confirmMovePanelTemplate: t('tickets.confirm_move_panel'), // enthält "{channel}"
  alertPanelPosted: t('tickets.alert_panel_posted'),
  alertPanelUpdated: t('tickets.alert_panel_updated'),
  alertImportLinkRequired: t('tickets.alert_import_link_required'),
  alertPanelImported: t('tickets.alert_panel_imported'),
};
---

<DashboardLayout title={t('tickets.title')} guildName={guildName} guildIconUrl={guildIconUrl ?? undefined} premiumActive={premiumActive} guildId={guildId}>
  <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-1">{t('tickets.title')}</h1>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {t('tickets.subtitle')}
  </p>

  {!botOnline && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6">
      <p class="text-sm text-amber-700 dark:text-amber-400">{t('common.bot_offline')}</p>
    </div>
  )}

  {!moduleEnabled && (
    <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/10 px-4 py-3 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">{t('tickets.module_disabled_title')}</p>
        <p class="text-sm text-amber-700/90 dark:text-amber-400/90">{t('tickets.module_disabled_desc')}</p>
      </div>
      <a href={`/server/${guildId}/modules/`} class="text-xs font-medium text-amber-700 dark:text-amber-400 hover:underline flex-shrink-0">{t('tickets.module_disabled_link')}</a>
    </div>
  )}

  <div id="tickets-tabs" data-config={JSON.stringify({ guildId, i18n, tabActive: TAB_ACTIVE, tabInactive: TAB_INACTIVE })}>
    <div role="tablist" aria-label={t('tickets.title')} class="flex gap-1 border-b border-slate-200 dark:border-slate-800 mb-6 overflow-x-auto overflow-y-hidden">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.key}`}
          data-tab={tab.key}
          aria-controls={`tab-panel-${tab.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class:list={['px-4 py-2.5 text-sm font-medium border-b-2 whitespace-nowrap transition-colors', i === 0 ? TAB_ACTIVE : TAB_INACTIVE]}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- ═══ Übersicht ═══ -->
    <div role="tabpanel" id="tab-panel-overview" aria-labelledby="tab-overview" data-tab-panel="overview">
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('tickets.open_tickets_title')}</h2>
          <span class="text-sm text-slate-500 dark:text-slate-400">{openTickets.length} {openTickets.length === 1 ? t('tickets.ticket_singular') : t('tickets.ticket_plural')}</span>
        </div>
        <div class="space-y-2">
          {openTickets.map((ticket) => (
            <div class="flex items-center gap-4 p-3 rounded-lg border border-slate-200 dark:border-slate-800">
              <span class="text-sm font-mono text-slate-400 flex-shrink-0">#{ticket.ticket_number}</span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-slate-900 dark:text-white truncate">{ticket.user_tag}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">{ticket.category_name}</p>
              </div>
              <Badge variant={statusVariant[ticket.status] ?? 'neutral'}>{statusLabel[ticket.status] ?? ticket.status}</Badge>
              <a
                href={`https://discord.com/channels/${guildId}/${ticket.channel_id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline flex-shrink-0"
              >
                {t('tickets.open_ticket_link')}
              </a>
            </div>
          ))}
        </div>
        {openTickets.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('tickets.no_open_tickets')}</p>}
      </section>
    </div>

    <!-- ═══ Panel ═══ -->
    <div role="tabpanel" id="tab-panel-panel" aria-labelledby="tab-panel" data-tab-panel="panel" class="hidden">
      <section class="rounded-xl glass-panel p-6 mb-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.panel_section_title')}</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">{t('tickets.panel_section_desc')}</p>

        <!-- Aktueller Stand -->
        <div class="mb-5 rounded-lg border border-slate-200 dark:border-slate-800 px-4 py-3">
          <p class={labelClass}>{t('tickets.panel_status_title')}</p>
          {hasPanel ? (
            <p class="text-sm text-slate-700 dark:text-slate-300">
              <span class="font-medium">{panelChannel ? `#${panelChannel.name}` : t('tickets.panel_unknown_channel')}</span>
              <a href={panelLink!} target="_blank" rel="noopener noreferrer" class="ml-2 text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline">{t('tickets.panel_status_open_link')}</a>
            </p>
          ) : panelWasDeleted ? (
            <p class="text-sm text-amber-600 dark:text-amber-400">{t('tickets.panel_status_missing')}</p>
          ) : (
            <p class="text-sm text-slate-500 dark:text-slate-400">{t('tickets.panel_status_none')}</p>
          )}
        </div>

        {botOnline && categories.length === 0 && (
          <p class="text-xs text-amber-600 dark:text-amber-400 mb-4">{t('tickets.panel_needs_categories')}</p>
        )}

        <div id="panel-form" data-has-panel={String(hasPanel)} data-panel-channel-id={panelChannelId ?? ''}>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
            <div>
              <label for="panel-channel-select" class={labelClass}>{t('tickets.target_channel_label')}</label>
              <select id="panel-channel-select" disabled={!botOnline} class={inputClass}>
                {channels.map((ch) => <option value={ch.id} selected={ch.id === panelChannelId}>#{ch.name}</option>)}
              </select>
              {hasPanel && <p class="mt-1.5 text-xs text-slate-400">{t('tickets.panel_channel_hint')}</p>}
            </div>
            <div>
              <label for="panel-title-input" class={labelClass}>{t('tickets.title_label')}</label>
              <input type="text" id="panel-title-input" maxlength="256" value={panelTitle} disabled={!botOnline} class={inputClass} />
            </div>
          </div>

          <div class="mb-3 max-w-xs">
            <label for="panel-mode-select" class={labelClass}>{t('tickets.panel_mode_label')}</label>
            <select id="panel-mode-select" disabled class={inputClass}>
              <option value="buttons" selected>{t('tickets.panel_mode_buttons')}</option>
              <option value="dropdown">{t('tickets.panel_mode_dropdown_soon')}</option>
            </select>
          </div>

          <div class="mb-4">
            <label for="tickets-textarea" class={labelClass}>{t('tickets.description_label')}</label>
            <div class="flex flex-wrap gap-1 mb-2" data-md-toolbar="tickets-textarea">
              {mdButtons.map((b) => (
                'sep' in b
                  ? <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
                  : <button type="button" data-md={b.md} title={b.title} class:list={[mdBtnClass, b.cls]}>{b.label}</button>
              ))}
            </div>
            <textarea id="tickets-textarea" rows="4" maxlength="1000" disabled={!botOnline} placeholder={t('tickets.description_placeholder')} class={`${inputClass} resize-none`}>{panelDescription}</textarea>
            <div class="mt-3 rounded-lg bg-slate-50 dark:bg-slate-800/50 p-3">
              <p class="text-xs text-slate-400 mb-1">{t('tickets.live_preview_label')}</p>
              {panelDescription
                ? <p id="tickets-preview" class="text-sm text-slate-700 dark:text-slate-300 italic" set:html={baseRenderPreview(panelDescription)} />
                : <p id="tickets-preview" class="text-sm text-slate-700 dark:text-slate-300 italic">—</p>}
            </div>
          </div>

          <button id="post-panel-btn" type="button" disabled={!botOnline || categories.length === 0} class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            {hasPanel ? t('tickets.update_panel_btn') : t('tickets.post_panel_btn')}
          </button>
        </div>
      </section>

      <!-- Bestehendes Panel übernehmen -->
      <section class="rounded-xl glass-panel p-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.import_title')}</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{t('tickets.import_desc')}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <input type="text" id="import-panel-input" placeholder={t('tickets.import_placeholder')} disabled={!botOnline} class={`${inputClass} sm:max-w-md`} />
          <button id="import-panel-btn" type="button" disabled={!botOnline} class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            {t('tickets.import_btn')}
          </button>
        </div>
      </section>
    </div>

    <!-- ═══ Kategorien ═══ -->
    <div role="tabpanel" id="tab-panel-categories" aria-labelledby="tab-categories" data-tab-panel="categories" class="hidden">
      <section class="rounded-xl glass-panel p-6">
        <div class="flex items-center justify-between mb-1">
          <h2 class="text-base font-bold text-slate-900 dark:text-white">{t('tickets.categories_title')}</h2>
          <button id="add-category-btn" type="button" disabled={!botOnline || categories.length >= limit} class="px-3 py-1.5 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            + {t('common.create')}
          </button>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">
          {t('tickets.categories_count', { count: categories.length, limit })}
          {!premiumActive && categories.length >= limitFree && (
            <span class="ml-1">— <Badge variant="primary">Premium</Badge> {t('tickets.premium_hint', { max: limitPremium })}</span>
          )}
        </p>

        <div id="categories-list" class="space-y-2">
          {categories.map((cat) => (
            <div class="p-3 rounded-lg border border-slate-200 dark:border-slate-800" data-category-row={cat.id} data-category-name={cat.name} data-role-ids={JSON.stringify(cat.role_ids)}>
              <div class="flex items-center justify-between gap-4">
                <span class="text-sm font-medium text-slate-900 dark:text-white">{cat.name}</span>
                <div class="flex items-center gap-3 flex-shrink-0">
                  <button type="button" data-edit-category={cat.id} disabled={!botOnline} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline disabled:opacity-50">{t('common.edit')}</button>
                  <button type="button" data-remove-category={cat.id} disabled={!botOnline} class="text-xs font-medium text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">{t('common.delete')}</button>
                </div>
              </div>
              <p class="mt-1 text-xs text-slate-400">
                {cat.roles.length > 0 ? t('tickets.access_prefix', { names: cat.roles.map((r) => r.name).join(', ') }) : t('tickets.admins_only')}
              </p>
            </div>
          ))}
        </div>
        {categories.length === 0 && <p class="text-sm text-slate-500 dark:text-slate-400 py-4">{t('tickets.no_categories')}</p>}

        <div id="category-form" class="hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <p id="category-form-title" class="text-sm font-semibold text-slate-900 dark:text-white mb-3">{t('tickets.category_form_add_title')}</p>
          <div class="mb-3 max-w-sm">
            <label for="category-name-input" class={labelClass}>{t('tickets.name_label')}</label>
            <input type="text" id="category-name-input" maxlength="100" placeholder={t('tickets.name_placeholder')} class={inputClass} />
          </div>
          <div class="mb-4">
            <p class={labelClass}>{t('tickets.allowed_roles_label')}</p>
            <div class="flex flex-wrap gap-2">
              {allRoles.map((r) => (
                <label class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 cursor-pointer has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 dark:has-[:checked]:bg-primary-950 text-sm">
                  <input type="checkbox" data-role-checkbox value={r.id} class="accent-primary-600" />
                  {r.name}
                </label>
              ))}
            </div>
          </div>
          <div class="flex gap-2">
            <button id="confirm-category-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors">{t('common.save')}</button>
            <button id="cancel-category-btn" type="button" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">{t('common.cancel')}</button>
          </div>
          <p class="mt-2 text-xs text-slate-400">{t('tickets.category_form_note')}</p>
        </div>
      </section>
    </div>

    <!-- ═══ Einstellungen ═══ -->
    <div role="tabpanel" id="tab-panel-settings" aria-labelledby="tab-settings" data-tab-panel="settings" class="hidden">
      <!-- Fristen -->
      <section class="rounded-xl glass-panel p-6 mb-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.timeouts_title')}</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">{t('tickets.timeouts_desc')}</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-4">
          <div>
            <label for="closure-select" class={labelClass}>{t('tickets.closure_label')}</label>
            <select id="closure-select" data-initial={String(closureHours ?? '')} disabled={!botOnline || ts === null} class={inputClass}>
              {closureOptions.map((h) => <option value={String(h)} selected={h === closureHours}>{durationLabel(h)}</option>)}
            </select>
            <p class="mt-1.5 text-xs text-slate-400">{t('tickets.closure_desc')}</p>
          </div>
          <div>
            <label for="deletion-select" class={labelClass}>{t('tickets.deletion_label')}</label>
            <select id="deletion-select" data-initial={String(deletionHours ?? '')} disabled={!botOnline || ts === null} class={inputClass}>
              {deletionOptions.map((h) => <option value={String(h)} selected={h === deletionHours}>{durationLabel(h)}</option>)}
            </select>
            <p class="mt-1.5 text-xs text-slate-400">{t('tickets.deletion_desc')}</p>
          </div>
        </div>

        <button id="save-timeouts-btn" type="button" disabled class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          {t('common.save')}
        </button>
      </section>

      <!-- Ticket-Log-Channel (auch in den globalen Einstellungen editierbar) -->
      <section class="rounded-xl glass-panel p-6">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">{t('tickets.log_channel_title')}</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{t('tickets.log_channel_desc')}</p>
        <div class="flex flex-col sm:flex-row sm:items-end gap-3">
          <div class="flex-1 max-w-xs">
            <select id="log-channel-select" aria-label={t('tickets.log_channel_title')} data-initial={logChannelId ?? ''} disabled={!botOnline} class={inputClass}>
              <option value="" selected={!logChannelId}>{t('common.no_channel')}</option>
              {logChannelId && !channels.some((c) => c.id === logChannelId) && <option value={logChannelId} selected>{logChannelId}</option>}
              {channels.map((ch) => <option value={ch.id} selected={ch.id === logChannelId}>#{ch.name}</option>)}
            </select>
          </div>
          <button id="save-log-channel-btn" type="button" disabled class="px-4 py-2 rounded-lg text-sm font-semibold btn-primary-surface hover:bg-primary-700 dark:hover:bg-primary-400 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            {t('common.save')}
          </button>
          <a href={`/server/${guildId}/settings/`} class="text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:underline self-center sm:self-end sm:mb-2.5">
            {t('tickets.also_in_settings')}
          </a>
        </div>
      </section>
    </div>
  </div>
</DashboardLayout>

